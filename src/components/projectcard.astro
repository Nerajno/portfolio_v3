---
// ProjectCard.astro
interface Project {
  name: string;
  description: string;
  image: {
    src: string;
    alt: string;
    link: string;
  };
  github?: string;
  website?: string;
  tags: string[];
  lastUpdated: string;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card dark:bg-gray-800 dark:text-white">
  <a href={project.image.link} target="_blank" rel="noopener noreferrer" class="image-link">
    <img
      src={project.image.src}
      alt={project.image.alt}
      width="400"
      height="250"
      loading="lazy"
      class="card-image"
    />
  </a>
  <div class="content">
    <h3 class="project-title">{project.name}</h3>
    <p class="project-description">{project.description}</p>
    <div class="card-footer">
      <div class="links">
        {project.github && (
          <a href={project.github} class="github-link" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        )}
        {project.website && (
          <a href={project.website} class="website-link" target="_blank" rel="noopener noreferrer">
            Live Demo
          </a>
        )}
      </div>
      <p class="tags">
        <strong>Tags:</strong> {project.tags.join(', ')}
      </p>
      <p class="last-updated">
        <strong>Last updated:</strong> <time datetime={project.lastUpdated}>{project.lastUpdated}</time>
      </p>
    </div>
  </div>
</article>

<style>
  .card {
    box-shadow: 2px 2px 5px #07A0C3;
    border-radius: 8px;
    padding: 16px;
    margin: 16px 0;
    background-color: #fff;
    color: #000;
    transition: box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    height: 550px; /* Fixed height for uniform cards */
    display: flex;
    flex-direction: column;
  }

  :global(.dark) .card {
    background-color: #1f2937;
    color: #fff;
    box-shadow: 2px 2px 5px rgba(7, 160, 195, 0.5);
  }

  :global(.dark) .card:hover {
    box-shadow: 4px 4px 10px rgba(7, 160, 195, 0.6);
  }

  .image-link {
    display: block;
    margin-bottom: 16px;
    flex-shrink: 0; /* Prevent image from shrinking */
  }

  .card-image {
    width: 100%;
    height: 200px; /* Fixed height for images */
    object-fit: cover; /* Maintain aspect ratio while filling space */
    border-radius: 4px;
  }

  .content {
    display: flex;
    flex-direction: column;
    flex: 1; /* Take remaining space */
    gap: 8px;
  }

  .project-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: bold;
    flex-shrink: 0;
  }

  .project-description {
    flex: 1; /* Take up available space */
    margin: 0;
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3; /* Limit to 3 lines */
    -webkit-box-orient: vertical;
  }

  .card-footer {
    margin-top: auto; /* Push to bottom */
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-shrink: 0;
  }

  .links {
    display: flex;
    gap: 16px;
  }

  .github-link,
  .website-link {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease, color 0.3s ease;
    text-align: center;
    flex: 1; /* Equal width buttons */
  }

  :global(.dark) .github-link {
    background-color: #374151;
    color: #fff;
  }

  :global(.dark) .website-link {
    background-color: #374151;
    color: #fff;
  }

  :global(.dark) .github-link:hover,
  :global(.dark) .website-link:hover {
    background-color: #4b5563;
  }

  .github-link {
    background-color: #24292e;
    color: #fff;
  }

  .website-link {
    background-color: #07A0C3;
    color: #fff;
  }

  .github-link:hover,
  .website-link:hover {
    opacity: 0.9;
  }

  .tags,
  .last-updated {
    margin: 0;
    font-size: 0.875rem;
    color: #666;
  }

  :global(.dark) .tags,
  :global(.dark) .last-updated {
    color: #d1d5db;
  }

  @media (prefers-color-scheme: dark) {
    .card {
      background-color: #1a1a1a;
      color: #fff;
    }

    .github-link {
      background-color: #6e7681;
    }

    .website-link {
      background-color: #0e8caa;
    }

    .tags,
    .last-updated {
      color: #d1d5db;
    }
  }

  @media (max-width: 768px) {
    .card {
      height: auto; /* Allow flexible height on mobile */
      min-height: 500px; /* But maintain minimum height */
    }

    .links {
      flex-direction: column;
      gap: 6px;
    }

    .github-link,
    .website-link {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .card {
      min-height: 450px;
    }

    .card-image {
      height: 150px; /* Smaller image on very small screens */
    }
  }
</style>
