---
// Outcomes-first project card (#458). Missing content renders as a visible
// "pending" placeholder, never as an invented value or a dead link.
const { project } = Astro.props;

const STATUS = {
  shipped: { label: 'Shipped', tone: 'bg-success text-on-success', marker: 'rounded-full' },
  in_progress: { label: 'In progress', tone: 'bg-warning text-on-warning', marker: 'rotate-45' },
};
const status = STATUS[project.shipStatus];
const proof = project.proof || {};
const hasProof = proof.ci || proof.deployed;
const isReal = (url) => typeof url === 'string' && url.length > 1 && url !== '#';
const links = [
  { label: 'Live demo', url: project.website, external: true },
  { label: 'Repo', url: project.github, external: true },
  { label: 'Case study', url: project.caseStudyUrl, external: false },
];
const pending = 'inline-flex items-center rounded border border-dashed border-surface-strong px-2 py-0.5 text-xs text-muted';
---

<article
  class='flex h-full flex-col gap-3 rounded-xl border border-surface bg-surface-card p-6'
  data-project={project.id}>
  {
    project.image?.src ? (
      <img
        src={project.image.src}
        alt={project.image.alt}
        class='aspect-video w-full rounded-lg object-cover'
        loading='lazy'
      />
    ) : (
      <div
        class='flex aspect-video w-full items-center justify-center rounded-lg border border-dashed border-surface-strong bg-surface-alt text-sm text-soft'
        data-pending='image'>
        Screenshot pending
      </div>
    )
  }

  <div class='flex flex-wrap items-center gap-2 text-xs font-medium'>
    {project.type && <span class='text-soft'>{project.type}</span>}
    {
      status && (
        <span class={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 ${status.tone}`}>
          <span aria-hidden='true' class={`inline-block h-2 w-2 bg-current ${status.marker}`} />
          {status.label}
        </span>
      )
    }
  </div>

  <h3 class='text-xl font-semibold text-strong'>{project.name}</h3>

  {
    project.outcome ? (
      <p class='text-base leading-relaxed text-body'>{project.outcome}</p>
    ) : (
      <p class={pending} data-pending='outcome'>Outcome headline pending</p>
    )
  }
  {
    project.impact ? (
      <p class='text-sm leading-relaxed text-soft'>{project.impact}</p>
    ) : (
      <p class={pending} data-pending='impact'>Impact sentence pending</p>
    )
  }

  <ul class='flex flex-wrap gap-2' aria-label='Stack'>
    {
      project.tags.map((tag) => (
        <li class='rounded border border-surface bg-surface-alt px-2.5 py-1 font-mono text-xs text-body'>{tag}</li>
      ))
    }
  </ul>

  <div class='flex flex-wrap gap-4 font-mono text-xs text-soft'>
    {proof.ci && <span>{proof.ci}</span>}
    {proof.deployed && <span>Deployed {proof.deployed}</span>}
    {!hasProof && <span class={pending} data-pending='proof'>Proof strip pending</span>}
  </div>

  <div class='mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 text-sm font-medium'>
    {
      links.map((link) =>
        isReal(link.url) ? (
          <a
            href={link.url}
            class='inline-flex min-h-11 items-center px-1 text-accent hover:text-accent-hover hover:underline'
            aria-label={`${link.label}: ${project.name}${link.external ? ' (opens in a new tab)' : ''}`}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {link.label} {link.external ? '↗' : '→'}
          </a>
        ) : (
          <span class={pending} data-pending={link.label.toLowerCase().replace(' ', '-')}>
            {link.label} pending
          </span>
        ),
      )
    }
  </div>
</article>
