---
// src/components/MediaAccordion.astro
import type { MediaItem } from '../data/otherMediaData';
import { formatDate } from '../utils/dates';

interface Props {
  media: MediaItem;
  index: number;
}

const { media, index } = Astro.props;

function getTypeIcon(type: MediaItem['type']) {
  switch (type) {
    case 'podcast': return '🎙️';
    case 'interview': return '🎤';
    case 'video': return '📹';
    case 'workshop-recording': return '🎥';
    case 'panel-discussion': return '👥';
    default: return '📱';
  }
}

function getTypeColor(type: MediaItem['type']) {
  const colors: Record<string, string> = {
    'podcast': 'tag-accent',
    'interview': 'tag-primary',
    'video': 'tag-accent',
    'workshop-recording': 'tag-accent',
    'panel-discussion': 'tag-primary'
  };
  return colors[type] ?? 'tag-primary';
}
---

<div class="accordion-item card rounded-lg mb-4 overflow-hidden transition-shadow hover:shadow-md">
  <button
    id={`accordion-header-${index}`}
    class="accordion-header w-full px-6 py-4 text-left bg-[var(--bg-card)] hover:bg-[var(--bg-surface-2)] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[var(--border-focus)] focus:ring-offset-2 focus:ring-offset-[var(--bg-card)]"
    aria-expanded="false"
    aria-controls={`accordion-content-${index}`}
    data-accordion-button
  >
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <div class="flex items-center gap-3 flex-wrap mb-2">
          <span class="text-xl" aria-hidden="true">{getTypeIcon(media.type)}</span>
          <h3 class="text-lg font-semibold flex items-center gap-2 group">
            {media.title}
            {media.links.primary && (
              <a 
                href={media.links.primary}
                target="_blank"
                rel="noopener noreferrer"
                class="link transition-colors"
                aria-label={`Open ${media.title} in new tab`}
                title="Open in new tab"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </h3>
        </div>
        <div class="flex items-center gap-4 text-sm text-muted">
          <span class={`tag ${getTypeColor(media.type)}`}>
            {media.type.replace('-', ' ')}
          </span>
          {media.platform && <span>{media.platform}</span>}
          <span>{formatDate(media.date)}</span>
          {media.duration && <span>⏱️ {media.duration}</span>}
        </div>
      </div>
      <svg
        class="accordion-icon w-5 h-5 text-muted transition-transform duration-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </button>

  <div
    id={`accordion-content-${index}`}
    class="accordion-content hidden"
    aria-labelledby={`accordion-header-${index}`}
  >
    <div class="px-6 py-4 bg-[var(--bg-surface-2)] border-t border-[var(--border-primary)]">
      <p class="text-muted mb-4 leading-relaxed">
        {media.description}
      </p>

      {media.host && (
        <p class="text-sm text-muted mb-2">
          <strong>Host:</strong> {media.host}
        </p>
      )}

      {media.publication && (
        <p class="text-sm text-muted mb-2">
          <strong>Published in:</strong> {media.publication}
        </p>
      )}

      {media.tags && media.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {media.tags.map(tag => (
            <span class="tag tag-primary">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <div class="flex flex-wrap gap-3 mt-4">
        {media.links.primary && (
          <a
            href={media.links.primary}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center text-sm focus-ring"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            View {media.type}
          </a>
        )}
        {media.links.secondary && (
          <a
            href={media.links.secondary}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center text-sm focus-ring"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Additional Link
          </a>
        )}
        {media.links.transcript && (
          <a
            href={media.links.transcript}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center text-sm focus-ring"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            View Transcript
          </a>
        )}
      </div>
    </div>
  </div>

<style>
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .accordion-content.show {
    display: block;
    max-height: 500px;
    transition: max-height 0.3s ease-in;
  }

  .accordion-header[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordionButtons = document.querySelectorAll('[data-accordion-button]');

    accordionButtons.forEach(button => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const content = button.nextElementSibling;

        if (content) {
          button.setAttribute('aria-expanded', (!expanded).toString());
          content.classList.toggle('show');
        }
      });
    });
  });
</script>
