---
// src/components/MediaAccordion.astro
import type { MediaItem } from '../data/otherMediaData';
import { formatDate } from '../utils/dates';
import { Icon } from 'astro-icon/components';

interface Props {
  media: MediaItem;
  index: number;
}

const { media, index } = Astro.props;

const mediaTypeIcon: Record<string, string> = {
  'podcast':            'bx:podcast',
  'interview':          'bx:microphone',
  'video':              'bx:video',
  'workshop-recording': 'bx:video',
  'panel-discussion':   'bx:group',
};

const mediaTypeTag: Record<string, string> = {
  'podcast':            'tag tag-accent',
  'interview':          'tag tag-info',
  'video':              'tag tag-neutral',
  'workshop-recording': 'tag tag-accent',
  'panel-discussion':   'tag tag-primary',
};
---

<div class="card mb-4 overflow-hidden">
  <button
    class="accordion-header w-full px-6 py-4 text-left focus-ring transition-colors duration-200 cursor-pointer"
    style="background-color: var(--bg-card)"
    aria-expanded="false"
    aria-controls={`accordion-content-${index}`}
    data-accordion-button
  >
    <div class="flex items-center justify-between">
      <div class="flex-1">
        <div class="flex items-center gap-3 flex-wrap mb-2">
          <Icon name={mediaTypeIcon[media.type] ?? 'bx:file'} class="w-5 h-5" aria-hidden="true" style="color: var(--color-primary)" />
          <h3 class="text-lg font-semibold flex items-center gap-2 group" style="color: var(--text-primary)">
            {media.title}
            {media.links.primary && (
              <a
                href={media.links.primary}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
                aria-label={`Open ${media.title} in new tab`}
                title="Open in new tab"
              >
                <Icon name="bx:link-external" class="h-4 w-4" aria-hidden="true" />
              </a>
            )}
          </h3>
        </div>
        <div class="flex items-center gap-3 flex-wrap text-sm" style="color: var(--text-muted)">
          <span class={mediaTypeTag[media.type] ?? 'tag tag-neutral'}>
            {media.type.replace('-', ' ')}
          </span>
          {media.platform && <span>{media.platform}</span>}
          <span>{formatDate(media.date)}</span>
          {media.duration && (
            <span class="flex items-center gap-1">
              <Icon name="bx:time" class="w-3.5 h-3.5" aria-hidden="true" />
              {media.duration}
            </span>
          )}
        </div>
      </div>
      <svg
        class="accordion-icon w-5 h-5 text-gray-500 transition-transform duration-200"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </button>

  <div
    id={`accordion-content-${index}`}
    class="accordion-content hidden"
    aria-labelledby={`accordion-header-${index}`}
  >
    <div class="px-6 py-4 border-t" style="background-color: var(--bg-secondary); border-color: var(--border-primary)">
      <p class="mb-4 leading-relaxed" style="color: var(--text-secondary)">
        {media.description}
      </p>

      {media.host && (
        <p class="text-sm mb-2" style="color: var(--text-muted)">
          <strong style="color: var(--text-primary)">Host:</strong> {media.host}
        </p>
      )}

      {media.publication && (
        <p class="text-sm mb-2" style="color: var(--text-muted)">
          <strong style="color: var(--text-primary)">Published in:</strong> {media.publication}
        </p>
      )}

      {media.tags && media.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {media.tags.map(tag => (
            <span class="tag tag-primary">#{tag}</span>
          ))}
        </div>
      )}

      <div class="flex flex-wrap gap-3 mt-4">
        {media.links.primary && (
          <a href={media.links.primary} target="_blank" rel="noopener noreferrer"
             class="btn-primary text-sm px-4 py-2 rounded-md">
            <Icon name="bx:link-external" class="h-4 w-4" aria-hidden="true" />
            View {media.type}
          </a>
        )}
        {media.links.secondary && (
          <a href={media.links.secondary} target="_blank" rel="noopener noreferrer"
             class="btn-secondary text-sm px-4 py-2 rounded-md">
            <Icon name="bx:link-external" class="h-4 w-4" aria-hidden="true" />
            Additional Link
          </a>
        )}
        {media.links.transcript && (
          <a href={media.links.transcript} target="_blank" rel="noopener noreferrer"
             class="btn-secondary text-sm px-4 py-2 rounded-md">
            <Icon name="bx:file" class="h-4 w-4" aria-hidden="true" />
            View Transcript
          </a>
        )}
      </div>
    </div>
  </div>

<style>
  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .accordion-content.show {
    display: block;
    max-height: 500px;
    transition: max-height 0.3s ease-in;
  }

  .accordion-header[aria-expanded="true"] .accordion-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordionButtons = document.querySelectorAll('[data-accordion-button]');

    accordionButtons.forEach(button => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const content = button.nextElementSibling;

        if (content) {
          button.setAttribute('aria-expanded', (!expanded).toString());
          content.classList.toggle('show');
        }
      });
    });
  });
</script>
