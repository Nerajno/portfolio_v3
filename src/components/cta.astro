---
import Link from "./ui/link.astro";
---

<div
  class="bg-black dark:bg-gray-900 p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Drop by and Say Hi.
  </h2>
  <p class="text-slate-400 dark:text-slate-300 mt-4 text-lg md:text-xl">
    Would love to hear from you if you have suggestions, critiques or just want to say hi.
  </p>
  <div class="flex mt-5">
    <Link href="#" style="inverted">Send a message</Link>
  </div>
</div>
