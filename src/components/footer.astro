---
import { Icon } from 'astro-icon/components';
---

<footer class='my-20 mb-5 footer'>
  <p class='text-center text-sm text-muted'>
    Copyright © {new Date().getFullYear()}, all rights reserved.
  </p>
  <p class='text-center text-xs text-muted mt-1'>
    <a
      href='https://twitter.com/nerajno'
      target='_blank'
      rel='noopener'
      class='link font-bold hover:underline'>
      Configured <Icon class='w-3 h-3 inline' name='bx:cog' /> and modified by <Icon
        class='w-3 h-3 inline'
        name='bx:cut'
      /> me
    </a>, but the source is
    <a
      href='https://web3templates.com/templates/astroship-starter-website-template-for-astro'
      target='_blank'
      rel='noopener'
      class='link hover:underline'>
      here <Icon class='w-3 h-3 inline' name='bx:link-external' />.
    </a>
  </p>
</footer>
