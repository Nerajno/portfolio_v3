---
// Learning project card (#472). Shows the garden stage (label + marker shape,
// never colour alone); missing fields render a visible "pending" placeholder.
const { project } = Astro.props;

const STAGE = {
  seedling: { marker: 'rounded-full border border-current bg-transparent' },
  budding: { marker: 'rounded-full bg-current' },
  evergreen: { marker: 'rotate-45 bg-current' },
};
const stage = STAGE[project.stage];
const title = project.title || project.name;
const isReal = (url) => typeof url === 'string' && url.length > 1 && url !== '#';
const pending = 'inline-flex items-center rounded border border-dashed border-surface-strong px-2 py-0.5 text-xs text-muted';
---

<article
  class='flex h-full flex-col gap-3 rounded-xl border border-surface bg-surface-card p-6'
  data-learning-project={project.id}>
  <p class='flex flex-wrap items-center gap-2 font-mono text-xs text-soft'>
    {
      stage ? (
        <span class='inline-flex items-center gap-1.5 text-accent'>
          <span aria-hidden='true' class={`inline-block h-2 w-2 ${stage.marker}`} />
          {project.stage}
        </span>
      ) : (
        <span class={pending} data-pending='stage'>stage pending</span>
      )
    }
  </p>

  <h3 class='text-xl font-semibold text-strong'>{title}</h3>

  {
    project.goal || project.description ? (
      <p class='text-sm leading-relaxed text-soft'>{project.goal || project.description}</p>
    ) : (
      <p class={pending}>Goal pending</p>
    )
  }

  {
    project.tags?.length > 0 && (
      <ul class='flex flex-wrap gap-2' aria-label='Stack'>
        {project.tags.map((tag) => (
          <li class='rounded border border-surface bg-surface-alt px-2.5 py-1 font-mono text-xs text-body'>{tag}</li>
        ))}
      </ul>
    )
  }

  <div class='mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 text-sm font-medium'>
    <a
      href={`/learning-projects/${project.id}`}
      class='inline-flex min-h-11 items-center px-1 text-accent hover:text-accent-hover hover:underline'
      aria-label={`Open learning plot: ${title}`}>
      Open plot →
    </a>
    {
      isReal(project.github) && (
        <a
          href={project.github}
          target='_blank'
          rel='noopener noreferrer'
          class='inline-flex min-h-11 items-center px-1 text-accent hover:text-accent-hover hover:underline'
          aria-label={`Repo: ${title} (opens in a new tab)`}>
          Repo ↗
        </a>
      )
    }
    {
      isReal(project.demo) && (
        <a
          href={project.demo}
          target='_blank'
          rel='noopener noreferrer'
          class='inline-flex min-h-11 items-center px-1 text-accent hover:text-accent-hover hover:underline'
          aria-label={`Live demo: ${title} (opens in a new tab)`}>
          Live demo ↗
        </a>
      )
    }
  </div>
</article>
