---
// Sub-navigation for the build surface pages (#460)
const links = [
  { label: 'how-i-build', href: '/how-i-build' },
  { label: 'decisions', href: '/decisions' },
  { label: 'artifacts', href: '/portfolio' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<nav aria-label='Build pages' class='flex flex-wrap gap-5 border-b border-surface pb-3 pt-6 font-mono text-sm'>
  {links.map((link) => (
    <a
      href={link.href}
      class={current === link.href ? 'font-bold text-accent' : 'text-body hover:text-accent'}
      aria-current={current === link.href ? 'page' : undefined}>
      {link.label}
    </a>
  ))}
</nav>
