---
---

<button
  id="theme-toggle"
  class="focus-ring rounded-md p-2 transition-colors hover:bg-[var(--color-primary-s)] lg:px-3 cursor-pointer"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  title="Toggle dark mode"
>
  <!-- Sun icon — shown when in dark mode -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="hidden"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>

  <!-- Moon icon — shown when in light mode -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme";
  const DARK  = "dark";
  const LIGHT = "light";

  const html     = document.documentElement;
  const btn      = document.getElementById("theme-toggle");
  const iconSun  = document.getElementById("icon-sun");
  const iconMoon = document.getElementById("icon-moon");

  /** Sync icon visibility and aria-pressed to current theme */
  function syncIcons(theme: string) {
    const isDark = theme === DARK;
    if (isDark) {
      iconSun?.classList.remove("hidden");
      iconMoon?.classList.add("hidden");
    } else {
      iconSun?.classList.add("hidden");
      iconMoon?.classList.remove("hidden");
    }
    btn?.setAttribute("aria-pressed", String(isDark));
  }

  /** Apply theme to <html> and persist it */
  function applyTheme(theme: string) {
    html.classList.remove(DARK, LIGHT);
    html.classList.add(theme);
    html.setAttribute("data-theme", theme);

    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch (_) {
      // localStorage unavailable — still apply visually
    }

    syncIcons(theme);
  }

  // Set initial icon state based on what the FOUC script already applied
  const currentTheme = html.classList.contains(DARK) ? DARK : LIGHT;
  syncIcons(currentTheme);

  // Toggle on click
  btn?.addEventListener("click", () => {
    const next = html.classList.contains(DARK) ? LIGHT : DARK;
    applyTheme(next);
  });

  // Sync across browser tabs
  window.addEventListener("storage", (e) => {
    if (e.key === STORAGE_KEY && (e.newValue === DARK || e.newValue === LIGHT)) {
      applyTheme(e.newValue);
    }
  });

  // Sync if user changes OS preference while page is open
  // (only when no explicit preference has been saved)
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      try {
        if (!localStorage.getItem(STORAGE_KEY)) {
          applyTheme(e.matches ? DARK : LIGHT);
        }
      } catch (_) {
        applyTheme(e.matches ? DARK : LIGHT);
      }
    });

  // Re-sync after Astro view transitions
  document.addEventListener("astro:after-swap", () => {
    syncIcons(html.classList.contains(DARK) ? DARK : LIGHT);
  });
</script>
