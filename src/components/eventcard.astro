---
import { formatDate } from '../utils/dates';
import type { ProcessedEvent } from '../types';

type Props = ProcessedEvent;

const {
  id,
  title,
  description,
  name,
  date,
  location,
  links,
  status,
  type,
  tags,
} = Astro.props;

function getStatusColor(status: 'upcoming' | 'past') {
  // upcoming → emerald (primary), past → muted accent
  return status === 'upcoming' ? 'tag-primary' : 'tag-accent';
}

function getTypeColor(
  type: 'conference' | 'workshop' | 'meetup' | 'webinar' | 'lightning-talk'
) {
  // All event types use design system tag tokens
  const colors: Record<string, string> = {
    conference: 'tag-primary',
    workshop: 'tag-accent',
    meetup: 'tag-accent',
    webinar: 'tag-primary',
    'lightning-talk': 'tag-accent',
  };
  return colors[type] ?? 'tag-primary';
}

function getEventTypeIcon(type: Props['type']) {
  switch (type) {
    case 'conference':
      return '🎤';
    case 'workshop':
      return '💻';
    case 'meetup':
      return '👥';
    case 'webinar':
      return '🎥';
    case 'lightning-talk':
      return '⚡';
    default:
      return '📅';
  }
}

const statusColor = getStatusColor(status);
const typeColor = getTypeColor(type);
const formattedDate = formatDate(date);
const locationString = [
  location.venue,
  location.city,
  location.state,
  location.country !== 'USA' ? location.country : null,
]
  .filter(Boolean)
  .join(', ');
---

<div
  class='card rounded-lg p-6 hover:shadow-md transition-shadow text-muted'>
  <div class='flex items-start justify-between gap-4'>
    <div class='flex-1'>
      <div class='flex items-center gap-2 flex-wrap'>
        <span class='text-xl' aria-hidden='true'>{getEventTypeIcon(type)}</span>
        <span class={`tag ${typeColor}`}>
          {type}
        </span>
        <span class={`tag ${statusColor}`}>
          {status === 'upcoming' ? 'Upcoming' : 'Past'}
        </span>
        {
          tags?.map((tag) => (
            <span class='tag tag-primary'>
              {tag}
            </span>
          ))
        }
      </div>

      <h3 class='text-xl font-semibold mt-2'>
        {title}
      </h3>
      <h4 class="mt-2 font-semibold italic link">{name}</h4>

      <div class='mt-2 text-muted'>
        <time datetime={date}>{formattedDate}</time>
        <span class='mx-2'>•</span>
        <span>{locationString}</span>
      </div>

      <p class='mt-3 text-muted'>{description}</p>
    </div>
  </div>

  {
    Object.entries(links).length > 0 && (
      <div class='mt-4 flex flex-wrap gap-3'>
        {Object.entries(links).map(
          ([key, url]) =>
            url && (
              <a
                href={url}
                class='link inline-flex items-center'
                target='_blank'
                rel='noopener noreferrer'>
                {key === 'conferenceWebsite'
                  ? 'Event Details'
                  : key === 'video'
                    ? 'Watch Recording'
                    : key === 'slides'
                      ? 'View Slides'
                      : key === 'article'
                        ? 'Read Article'
                        : key === 'github'
                          ? 'View Code'
                          : key.charAt(0).toUpperCase() + key.slice(1)}{' '}
                →
              </a>
            )
        )}
      </div>
    )
  }
</div>
