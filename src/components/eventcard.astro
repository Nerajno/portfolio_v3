---
import { formatDate } from '../utils/dates';
import type { ProcessedEvent } from '../types';

type Props = ProcessedEvent;

const {
  id,
  title,
  description,
  name,
  date,
  location,
  links,
  status,
  type,
  tags,
} = Astro.props;

function getStatusColor(status: 'upcoming' | 'past') {
  return status === 'upcoming'
    ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300'
    : 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300';
}

function getTypeColor(
  type: 'conference' | 'workshop' | 'meetup' | 'webinar' | 'lightning-talk'
) {
  const colors = {
    conference: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300',
    workshop:
      'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300',
    meetup:
      'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300',
    webinar: 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-300',
    'lightening-talk':
      'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300',
  };
  return colors[type];
}

function getEventTypeIcon(type: Props['type']) {
  switch (type) {
    case 'conference':
      return '🎤';
    case 'workshop':
      return '💻';
    case 'meetup':
      return '👥';
    case 'webinar':
      return '🎥';
    case 'lightning-talk':
      return '⚡';
    default:
      return '📅';
  }
}

const statusColor = getStatusColor(status);
const typeColor = getTypeColor(type);
const formattedDate = formatDate(date);
const locationString = [
  location.venue,
  location.city,
  location.state,
  location.country !== 'USA' ? location.country : null,
]
  .filter(Boolean)
  .join(', ');
---

<div
  class='bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-gray-200 dark:border-slate-700 p-6 hover:shadow-md dark:hover:shadow-lg transition-shadow text-slate-500 dark:text-slate-400'>
  <div class='flex items-start justify-between gap-4'>
    <div class='flex-1'>
      <div class='flex items-center gap-2 flex-wrap'>
        <span class='text-xl' aria-hidden='true'>{getEventTypeIcon(type)}</span>
        <span class={`px-2 py-1 text-sm rounded-full ${typeColor}`}>
          {type}
        </span>
        <span class={`px-2 py-1 text-sm rounded-full ${statusColor}`}>
          {status === 'upcoming' ? 'Upcoming' : 'Past'}
        </span>
        {
          tags?.map((tag) => (
            <span class='px-2 py-1 text-sm rounded-full bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300'>
              {tag}
            </span>
          ))
        }
      </div>

      <h3 class='text-xl font-semibold mt-2 text-gray-900 dark:text-slate-100'>
        {title}
      </h3>
      <h4 class="mt-2 font-semibold italic text-gray-600 dark:text-slate-40">{name}</h4>
      <!-- {
        name && name !== 'Demo Name' && (
          <h3 class='text-sm text-gray-600 dark:text-slate-400 mt-1'>{name}</h3>
        )
      } -->
      <div class='mt-2 text-gray-600 dark:text-slate-400'>
        <time datetime={date}>{formattedDate}</time>
        <span class='mx-2'>•</span>
        <span>{locationString}</span>
      </div>

      <p class='mt-3 text-gray-700 dark:text-slate-300'>{description}</p>
    </div>
  </div>

  {
    Object.entries(links).length > 0 && (
      <div class='mt-4 flex flex-wrap gap-3'>
        {Object.entries(links).map(
          ([key, url]) =>
            url && (
              <a
                href={url}
                class='inline-flex items-center text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300'
                target='_blank'
                rel='noopener noreferrer'>
                {key === 'conferenceWebsite'
                  ? 'Event Details'
                  : key === 'video'
                    ? 'Watch Recording'
                    : key === 'slides'
                      ? 'View Slides'
                      : key === 'article'
                        ? 'Read Article'
                        : key === 'github'
                          ? 'View Code'
                          : key.charAt(0).toUpperCase() + key.slice(1)}{' '}
                →
              </a>
            )
        )}
      </div>
    )
  }
</div>
