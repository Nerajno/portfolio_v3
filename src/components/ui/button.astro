---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline:  "btn-inverted",
  primary:  "btn-primary border-2 border-transparent",
  inverted: "btn-inverted",
};
---

<button
  {...rest}
  class:list={[
    "rounded text-center transition focus-ring",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
><slot /></button>
