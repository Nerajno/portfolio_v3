---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border-2 border-brand-cyan dark:border-dark-brand-cyan hover:bg-brand-cyan dark:hover:bg-dark-brand-cyan text-brand-cyan dark:text-dark-brand-cyan hover:text-white dark:hover:text-dark-bg-primary",
  primary: "bg-brand-coral dark:bg-dark-brand-coral text-white hover:bg-brand-coral/80 dark:hover:bg-dark-brand-coral/80 border-2 border-transparent",
  inverted: "bg-white dark:bg-dark-bg-secondary text-brand-primary dark:text-dark-text-primary hover:bg-brand-silver dark:hover:bg-dark-bg-tertiary border-2 border-transparent",
};
---

<button
  {...rest}
  class:list={[
    "rounded text-center transition focus-visible:ring-2 ring-offset-2 ring-brand-cyan dark:ring-dark-brand-cyan dark:ring-offset-dark-bg-primary",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
><slot /></button>
