---
// @ts-ignore
import { Icon } from 'astro-icon/components';

// Technology data with names, labels, and official brand colors (hex values)
const technologies = [
  { name: 'simple-icons:react', label: 'React', color: '#61DAFB' },
  { name: 'simple-icons:vuedotjs', label: 'Vue.js', color: '#4FC08D' },
  { name: 'simple-icons:javascript', label: 'JavaScript', color: '#F7DF1E' },
  { name: 'simple-icons:ruby', label: 'Ruby', color: '#CC342D' },
  { name: 'simple-icons:rubyonrails', label: 'Ruby on Rails', color: '#D30001' },
  { name: 'simple-icons:vercel', label: 'Vercel', color: '#000000' },
  { name: 'simple-icons:astro', label: 'Astro', color: '#BC52EE' },
  { name: 'simple-icons:python', label: 'Python', color: '#3776AB' },
  { name: 'simple-icons:typescript', label: 'TypeScript', color: '#3178C6' },
  { name: 'simple-icons:mongodb', label: 'MongoDB', color: '#47A248' },
  { name: 'simple-icons:confluence', label: 'Confluence', color: '#172B4D' },
  { name: 'simple-icons:netlify', label: 'Netlify', color: '#00C7B7' },
  { name: 'simple-icons:git', label: 'Git', color: '#F05032' },
  { name: 'simple-icons:nodedotjs', label: 'Node.js', color: '#339933' },
  { name: 'simple-icons:asana', label: 'Asana', color: '#273347' },
  { name: 'simple-icons:figma', label: 'Figma', color: '#F24E1E' }
];
---

<div class='mt-24'>
  <h2 class='text-center text-xl font-semibold font-medium dark:text-white text-slate-600'>
    Some Technologies and Tooling I have had experience with :
  </h2>

  <div class='flex gap-6 md:gap-10 items-center justify-center mt-10 flex-wrap max-w-4xl mx-auto'>
    {technologies.map((tech) => (
      <div class='group flex flex-col items-center gap-2 p-3 rounded-lg transition-all duration-300 hover:bg-slate-100 dark:hover:bg-slate-800'>
        {/* Icon with responsive coloring */}
        <Icon
          class={`h-[2em] w-[2em] transition-colors duration-300
                  ${tech.color} md:text-slate-400 md:dark:text-slate-500
                  md:group-hover:${tech.color.replace('text-', '')}
                  group-hover:scale-110`}
          name={tech.name}
        />

        {/* Technology name - always visible on mobile, visible on hover for desktop */}
        <span class={`text-sm font-medium transition-all duration-300
                     ${tech.color} md:text-slate-600 md:dark:text-slate-400
                     block md:opacity-0 md:group-hover:opacity-100
                     md:group-hover:${tech.color.replace('text-', '')}
                     text-center`}>
          {tech.label}
        </span>
      </div>
    ))}
  </div>
</div>
