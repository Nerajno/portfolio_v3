---
// @ts-ignore
import { Icon } from 'astro-icon/components';
---

<div class='mt-24'>
  <h2 class='text-center text-slate-500'>
    Some Technologies and Tooling I have had experience with :
  </h2>
  <div
    class='flex gap-10 md:gap-20 items-center justify-center mt-10 flex-wrap'>
    <Icon class='h-[2em] w-[2em]' name='simple-icons:react' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:vuedotjs' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:javascript' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:ruby' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:rubyonrails' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:vercel' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:astro' />
    <Icon class='h-[2em] w-[2em]' name='simple-icons:python' />
  </div>

<div class="flex gap-10 md:gap-20 items-center justify-center mt-10 flex-wrap">
  <Icon class="h-[2em] w-[2em]" name="simple-icons:typescript" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:mongodb" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:confluence" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:netlify" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:git" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:nodedotjs" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:asana" />
  <Icon class="h-[2em] w-[2em]" name="simple-icons:figma" />
</div>
</div>
