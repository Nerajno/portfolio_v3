---
import { Picture } from 'astro:assets';
import heroImage from 'assets/Banner_for_site.png';

const button = 'inline-flex min-h-11 items-center justify-center rounded-lg px-6 py-3 text-base font-semibold';
const pending = 'inline-flex min-h-11 items-center justify-center rounded-lg border border-dashed border-surface-strong px-6 py-3 text-base text-muted';
---

<section
  class='grid lg:grid-cols-[3fr_2fr] items-center gap-10 pt-6 pb-8 md:pt-10 md:pb-16'
  aria-labelledby='hero-heading'>

  <div class='py-6 order-last lg:order-1 max-w-md justify-self-center'>
    <Picture
      src={heroImage}
      alt='Professional headshot of Nerando, a software engineer specializing in Vue.js and JavaScript front-end development'
      widths={[200, 400, 600]}
      sizes='(max-width: 800px) 100vw, 620px'
      loading='eager'
      format='avif'
    />
  </div>

  <div itemscope itemtype='https://schema.org/Person'>
    <p class='text-sm font-semibold uppercase tracking-widest text-accent'>
      Hi, I am <span itemprop='name'>Nerando</span>
    </p>

    <h1
      id='hero-heading'
      class='mt-3 text-3xl sm:text-4xl xl:text-5xl font-bold leading-tight tracking-tight text-strong'>
      Software engineer who ships, writes, and teaches code on the frontend (including Vue3)
    </h1>

    <!-- CTA row sits directly under the headline so the hiring CTA stays above the fold at 375x667 (#455) -->
    <div class='mt-6 flex flex-wrap gap-3'>
      <a href='/contact' class={`${button} bg-accent text-surface hover:bg-accent-hover`}>
        Work with me
      </a>
      <a href='/portfolio' class={`${button} border border-surface-strong bg-surface-card text-body hover:bg-surface-alt`}>
        See my work
      </a>
      <span class={pending} data-pending='resume'>Résumé pending</span>
    </div>

    <p class='mt-4 text-sm' data-pending='target-roles'>
      <span class='inline-flex items-center rounded border border-dashed border-surface-strong px-2 py-0.5 text-xs text-muted'>
        Target roles link pending
      </span>
    </p>

    <p class='mt-6 text-base md:text-lg leading-relaxed text-body max-w-2xl' itemprop='description'>
      I am a <span itemprop='jobTitle'>front-end software engineer</span> who ships with{' '}
      <span itemprop='knowsAbout'>Vue 3, TypeScript, and Nuxt</span> — and who cares as much about why an
      interface works as whether it does. Five-plus years in the Atlanta tech community have taught me that
      good software is a team sport: I build, I write about it, and I teach what I learn. Outside of tech,
      I am a bookworm with a spatula among other things.
    </p>

    <!-- Hidden structured data for better SEO -->
    <meta itemprop='url' content='https://developingdvlpr.com' />
    <meta itemprop='sameAs' content='https://garden.developingdvlpr.com' />
  </div>
</section>
