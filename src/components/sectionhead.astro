---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-16", align === "center" && "text-center"]}>
  <h1 class="font-heading text-4xl lg:text-5xl font-bold lg:tracking-tight text-brand-primary dark:text-dark-text-primary">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-lg mt-4 text-gray-600 dark:text-dark-text-secondary">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
