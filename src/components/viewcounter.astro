---
import { db, Views, sql } from 'astro:db';
const { slug } = Astro.props;
let item;
try {
  const result = await db
    .insert(Views)
    .values({ slug, count: 1 })
    .onConflictDoUpdate({ target: Views.slug, set: { count: sql`count + 1` } })
    .returning({ slug: Views.slug, count: Views.count });
  item = result[0];
} catch (error) {
  console.error(error);
  item = { slug, count: 1 };
}
---

<div><p>Views: {item.count} {item.count === 1 ? '🧐' : '🤓'}</p></div>
