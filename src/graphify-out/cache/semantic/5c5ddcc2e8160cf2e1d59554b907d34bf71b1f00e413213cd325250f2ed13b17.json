{"nodes": [{"id": "side_project_article", "label": "Start With the End in Mind: The Developer's Guide to Shipping Side Projects", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null, "rationale": "Most side projects fail from undefined scope and perfectionism rather than lack of time or skill; defining 'done' before writing code is the core lever for shipping."}, {"id": "side_project_kill_list_framework", "label": "Kill List Framework", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null, "rationale": "Limiting scope to 3 MUST-HAVE and 5 SHOULD-HAVE features, with explicit WON'T-HAVE documentation, prevents scope creep from killing project completion."}, {"id": "side_project_recovery_protocol_48hr", "label": "48-Hour Recovery Protocol", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null}, {"id": "side_project_thirty_day_sprint", "label": "30-Day Sprint Structure", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null}, {"id": "side_project_boring_tech_principle", "label": "Boring Tech Principle", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null, "rationale": "Introducing new technology while trying to ship multiplies complexity; familiar tools should be used when shipping, not learning, is the goal."}, {"id": "side_project_two_file_start", "label": "Two-File Start (Anti Analysis-Paralysis)", "file_type": "document", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null}, {"id": "side_project_isnerandodoneyet", "label": "isNerandoDoneYet (Example Project)", "file_type": "code", "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Nerando Johnson", "contributor": null}], "edges": [{"source": "side_project_article", "target": "side_project_kill_list_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "weight": 1.0}, {"source": "side_project_article", "target": "side_project_recovery_protocol_48hr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "weight": 1.0}, {"source": "side_project_article", "target": "side_project_thirty_day_sprint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "source_location": null, "weight": 1.0}, {"source": "side_project_article", "target": "side_project_boring_tech_principle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/blog/start-with-the-end-in-mind-developers-side-project-survival-guide.md", "sour