---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { SEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import { getAllViewCounts } from '../lib/supabase';

export const prerender = true;
export const revalidate = 60;

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection('blog', ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
const sortedBlogEntries = [...publishedBlogEntries].sort((a, b) => {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Fetch all view counts in a single query for performance
const isDevelopment = import.meta.env.MODE === 'development';
let allViewCounts: Record<string, number> = {};

if (!isDevelopment || import.meta.env.TRACK_VIEWS_IN_DEV === 'true') {
  allViewCounts = await getAllViewCounts();
}

// SEO configuration for the blog page
const seoConfig = {
  title: 'My MetaData - Blog & Learning Notes',
  description:
    "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
  canonical: new URL('blog', Astro.site).toString(),
  openGraph: {
    basic: {
      title: 'My MetaData - Blog & Learning Notes',
      type: 'website',
      image: '/og-blog.jpg',
      url: new URL('blog', Astro.site).toString(),
    },
    optional: {
      description:
        "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
      siteName: 'My MetaData',
    },
    image: {
      alt: 'My MetaData Blog - Learning and Development Resources',
    },
  },
  twitter: {
    creator: '@nerajno',
    site: '@nerajno',
    card: 'summary_large_image' as const,
  },
};
---

<Layout title='Blog'>
  <SEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={{
      meta: [
        { name: 'robots', content: 'index, follow' },
        { name: 'author', content: 'Nerando Johnson' },
        {
          name: 'keywords',
          content:
            'blog, programming, web development, learning, technology, tutorials',
        },
        { property: 'article:author', content: 'Nerando Johnson' },
        { property: 'article:section', content: 'Technology' },
        { property: 'og:locale', content: 'en_US' },
        { name: 'theme-color', content: '#1e293b' },
        { name: 'geo.region', content: 'US-GA' },
        { name: 'geo.placename', content: 'Atlanta' },
        { property: 'profile:first_name', content: 'Nerando' },
        { property: 'profile:last_name', content: 'Johnson' },
      ],
      link: [
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'My MetaData Blog RSS',
          href: '/rss.xml',
        },
      ],
    }}
  />

  <!-- JSON-LD Structured Data for Blog with GEO optimization -->
  <script
    type='application/ld+json'
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'My MetaData Blog',
      description:
        "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
      url: new URL('blog', Astro.site).toString(),
      author: {
        '@type': 'Person',
        name: 'Nerando Johnson',
        url: Astro.site?.toString(),
        jobTitle: 'Software Developer',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Atlanta',
          addressRegion: 'GA',
          addressCountry: 'US',
        },
        sameAs: [
          'https://github.com/Nerajno',
          'https://twitter.com/nerajno',
          'https://www.linkedin.com/in/nerando-johnson/',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'My MetaData',
        url: Astro.site?.toString(),
      },
      blogPost: sortedBlogEntries.slice(0, 10).map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        description: post.data.snippet || post.data.title,
        url: new URL(`blog/${post.slug}`, Astro.site).toString(),
        datePublished: post.data.publishDate.toISOString(),
        dateModified:
          post.data.updatedDate?.toISOString() ||
          post.data.publishDate.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Nerando Johnson',
        },
        image: post.data.image?.src,
        articleSection: post.data.category,
      })),
    })}
  />

  <Container>
    <Sectionhead>
      <Fragment slot='title'>My MetaData</Fragment>
      <Fragment slot='desc'>
        Notes and blog posts created from things I've learned. All these articles
        I've written that helped me level up my skills and knowledge.
      </Fragment>
    </Sectionhead>

    <main class='mt-16'>
      {/* Enhanced Filter Controls */}
      <div class='max-w-5xl mx-auto mb-16'>
        <div class='bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-lg border border-slate-200 dark:border-slate-700'>
          <div class='grid md:grid-cols-2 gap-4'>
            <div>
              <label
                for='search'
                class='block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2'
              >
                Search Posts
              </label>
              <input
                type='text'
                id='search'
                class='w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white transition-all'
                placeholder='Search by title or tags...'
              />
            </div>
            <div>
              <label
                for='sort'
                class='block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2'
              >
                Sort By
              </label>
              <select
                id='sort'
                class='w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white transition-all'
              >
                <option value='newest'>Newest First</option>
                <option value='oldest'>Oldest First</option>
                <option value='title-asc'>Title (A-Z)</option>
                <option value='title-desc'>Title (Z-A)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      {/* Blog Posts Grid */}
      <div id='blog-posts' class='grid gap-12 max-w-5xl mx-auto'>
        {
          sortedBlogEntries.map((blogPostEntry, index) => (
            <article class='blog-post-item group' style='list-style: none;'>
              <a
                href={`/blog/${blogPostEntry.slug}`}
                class='block transition-all duration-300'
              >
                <div class='grid md:grid-cols-[280px_1fr] gap-8 items-start'>
                  {/* Image */}
                  <div class='relative overflow-hidden rounded-xl'>
                    <Picture
                      src={blogPostEntry.data.image.src}
                      alt={blogPostEntry.data.image.alt}
                      sizes='(max-width: 768px) 100vw, 280px'
                      width={280}
                      height={187}
                      format='webp'
                      quality={85}
                      loading={index <= 2 ? 'eager' : 'lazy'}
                      decoding={index <= 2 ? 'sync' : 'async'}
                      class='w-full aspect-[3/2] object-cover transition-transform duration-500 group-hover:scale-105'
                    />
                    <div class='absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300' />
                  </div>

                  {/* Content */}
                  <div class='flex flex-col'>
                    {/* Category Badge */}
                    <span class='inline-block text-blue-500 dark:text-blue-400 uppercase tracking-wider text-xs font-bold mb-3'>
                      {blogPostEntry.data.category}
                    </span>

                    {/* Title */}
                    <h2 class='text-2xl md:text-3xl font-bold leading-tight mb-3 text-slate-900 dark:text-slate-50 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200'>
                      {blogPostEntry.data.title}
                    </h2>

                    {/* Snippet */}
                    {blogPostEntry.data.snippet && (
                      <p class='text-slate-600 dark:text-slate-400 mb-4 leading-relaxed line-clamp-2 text-base'>
                        {blogPostEntry.data.snippet}
                      </p>
                    )}

                    {/* Metadata */}
                    <div class='flex gap-3 text-sm text-slate-500 dark:text-slate-400 items-center mb-4'>
                      <time datetime={blogPostEntry.data.publishDate.toISOString()}>
                        {new Date(blogPostEntry.data.publishDate).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                      <span>•</span>
                      <span
                        class='inline-flex items-center gap-1.5 view-counter-display'
                        data-slug={blogPostEntry.slug}
                      >
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='14'
                          height='14'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='2'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                        >
                          <path d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z' />
                          <circle cx='12' cy='12' r='3' />
                        </svg>
                        <span class='view-count-text'>
                          {isDevelopment &&
                          import.meta.env.TRACK_VIEWS_IN_DEV !== 'true'
                            ? '-- views'
                            : `${(allViewCounts[blogPostEntry.slug] || 0).toLocaleString()} ${allViewCounts[blogPostEntry.slug] === 1 ? 'view' : 'views'}`}
                        </span>
                      </span>
                    </div>

                    {/* Tags */}
                    {blogPostEntry.data.tags &&
                      blogPostEntry.data.tags.length > 0 && (
                        <div
                          class='flex gap-2 flex-wrap'
                          data-tags={blogPostEntry.data.tags.join(',')}
                        >
                          {blogPostEntry.data.tags.slice(0, 4).map((tag: string) => (
                            <span class='text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors'>
                              {tag}
                            </span>
                          ))}
                          {blogPostEntry.data.tags.length > 4 && (
                            <span class='text-xs px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium'>
                              +{blogPostEntry.data.tags.length - 4}
                            </span>
                          )}
                        </div>
                      )}
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      {/* No Results Message */}
      <div
        id='no-results'
        class='hidden text-center py-12 max-w-5xl mx-auto'
      >
        <div class='text-slate-400 dark:text-slate-500'>
          <svg
            class='w-16 h-16 mx-auto mb-4 opacity-50'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              stroke-width='2'
              d='M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
            />
          </svg>
          <p class='text-xl font-semibold mb-2'>No posts found</p>
          <p class='text-sm'>Try adjusting your search or filters</p>
        </div>
      </div>

      <script>
        const blogPosts = document.getElementById('blog-posts');
        const searchInput = document.getElementById('search') as HTMLInputElement;
        const sortSelect = document.getElementById('sort') as HTMLSelectElement;
        const noResults = document.getElementById('no-results');

        // Debounce function
        function debounce(func: Function, wait: number) {
          let timeout: ReturnType<typeof setTimeout>;
          return function executedFunction(...args: any[]) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // Update view counts client-side
        async function updateViewCounts() {
          const viewCounters = document.querySelectorAll('.view-counter-display');

          for (const counter of viewCounters) {
            const slug = counter.getAttribute('data-slug');
            const textEl = counter.querySelector('.view-count-text');

            if (slug && textEl) {
              try {
                const response = await fetch(`/api/views/${slug}`);
                const data = await response.json();

                if (data.count !== undefined) {
                  const formatted = data.count.toLocaleString();
                  const label = data.count === 1 ? 'view' : 'views';
                  textEl.textContent = `${formatted} ${label}`;
                }
              } catch (err) {
                console.error(`Failed to fetch view count for ${slug}:`, err);
              }
            }
          }
        }

        // Update view counts when page loads
        updateViewCounts();

        // Filter posts function
        function filterPosts() {
          const searchTerm = searchInput?.value?.toLowerCase().trim() || '';
          const sortBy = sortSelect?.value || 'newest';

          // Get all post elements
          const posts = Array.from(
            document.querySelectorAll('#blog-posts > article')
          );

          // Filter posts by title or tags
          let filteredPosts = posts.filter((post) => {
            if (!searchTerm) return true;

            const titleEl = post.querySelector('h2');
            const title = titleEl?.textContent?.toLowerCase() || '';
            const snippetEl = post.querySelector('p');
            const snippet = snippetEl?.textContent?.toLowerCase() || '';
            const tagsContainer = post.querySelector('[data-tags]');
            const tags =
              tagsContainer?.getAttribute('data-tags')?.toLowerCase() || '';

            // Search in title, snippet, and tags
            return (
              title.includes(searchTerm) ||
              snippet.includes(searchTerm) ||
              tags.includes(searchTerm)
            );
          });

          // Sort posts based on selected option
          switch (sortBy) {
            case 'oldest':
              filteredPosts.sort((a, b) => {
                const timeA = a.querySelector('time')?.getAttribute('datetime');
                const timeB = b.querySelector('time')?.getAttribute('datetime');
                if (!timeA || !timeB) return 0;
                return new Date(timeA).valueOf() - new Date(timeB).valueOf();
              });
              break;
            case 'title-asc':
              filteredPosts.sort((a, b) => {
                const titleA =
                  a.querySelector('h2')?.textContent?.toLowerCase() || '';
                const titleB =
                  b.querySelector('h2')?.textContent?.toLowerCase() || '';
                return titleA.localeCompare(titleB);
              });
              break;
            case 'title-desc':
              filteredPosts.sort((a, b) => {
                const titleA =
                  a.querySelector('h2')?.textContent?.toLowerCase() || '';
                const titleB =
                  b.querySelector('h2')?.textContent?.toLowerCase() || '';
                return titleB.localeCompare(titleA);
              });
              break;
            default: // 'newest' (default)
              filteredPosts.sort((a, b) => {
                const timeA = a.querySelector('time')?.getAttribute('datetime');
                const timeB = b.querySelector('time')?.getAttribute('datetime');
                if (!timeA || !timeB) return 0;
                return new Date(timeB).valueOf() - new Date(timeA).valueOf();
              });
          }

          // Show/hide no results message
          if (filteredPosts.length === 0) {
            noResults?.classList.remove('hidden');
            blogPosts?.classList.add('hidden');
          } else {
            noResults?.classList.add('hidden');
            blogPosts?.classList.remove('hidden');
          }

          // Clear and re-add sorted posts
          if (!blogPosts) {
            console.error('Blog posts container not found');
            return;
          }

          blogPosts.innerHTML = '';
          filteredPosts.forEach((post) => blogPosts.appendChild(post));
        }

        // Create debounced version of filterPosts (300ms delay)
        const debouncedFilterPosts = debounce(filterPosts, 300);

        // Add event listeners
        searchInput?.addEventListener('input', debouncedFilterPosts);
        sortSelect?.addEventListener('change', filterPosts);
      </script>
    </main>
  </Container>
</Layout>

<style>
  /* Smooth transitions for all interactive elements */
  .blog-post-item {
    transition: transform 0.2s ease-out;
  }

  /* Add subtle animation on scroll */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .blog-post-item {
    animation: fadeInUp 0.6s ease-out;
    animation-fill-mode: both;
  }

  /* Stagger animation for multiple posts */
  .blog-post-item:nth-child(1) {
    animation-delay: 0.1s;
  }
  .blog-post-item:nth-child(2) {
    animation-delay: 0.2s;
  }
  .blog-post-item:nth-child(3) {
    animation-delay: 0.3s;
  }
  .blog-post-item:nth-child(4) {
    animation-delay: 0.4s;
  }
  .blog-post-item:nth-child(5) {
    animation-delay: 0.5s;
  }

  /* Utility for line clamping */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
