---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { minutesRead } from '../lib/readingTime';
import { SEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import { getAllViewCounts } from '../lib/supabase';
export const prerender = true;
export const revalidate = 60; // Revalidate every 60 seconds

// Filter blog entries with 'draft: false' & date before current date
const publishedBlogEntries = await getCollection('blog', ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
const sortedBlogEntries = [...publishedBlogEntries].sort((a, b) => {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

// Fetch all view counts in a single query for performance
const isDevelopment = import.meta.env.MODE === 'development';
let allViewCounts: Record<string, number> = {};

if (!isDevelopment || import.meta.env.TRACK_VIEWS_IN_DEV === 'true') {
  try {
    const viewCountsPromise = getAllViewCounts();
    const timeoutPromise = new Promise<Record<string, number>>((resolve) =>
      setTimeout(() => resolve({}), 5000)
    );
    allViewCounts = await Promise.race([viewCountsPromise, timeoutPromise]);
  } catch {
    allViewCounts = {};
  }
}

// Get reading time for each blog post
const blogEntriesWithReadingTime = sortedBlogEntries.map((entry) => ({
  ...entry,
  minutesRead: minutesRead(entry.body),
}));

// Group posts by series for quick lookups
const seriesMap = new Map<string, typeof blogEntriesWithReadingTime>();
blogEntriesWithReadingTime.forEach((post) => {
  if (post.data.series?.name) {
    const seriesName = post.data.series.name;
    if (!seriesMap.has(seriesName)) {
      seriesMap.set(seriesName, []);
    }
    seriesMap.get(seriesName)!.push(post);
  }
});

// Get unique series names
const allSeries = Array.from(seriesMap.keys());

// #341 redesign data
const slugOf = (entry) => entry.id.replace(/\.(md|mdx)$/, '');
const seriesSlug = (name) => name.toLowerCase().replace(/\s+/g, '-');
const featuredPost =
  blogEntriesWithReadingTime.find((post) => post.data.featured) ?? blogEntriesWithReadingTime[0];
const viewsLabel = (slug) => {
  if (isDevelopment && import.meta.env.TRACK_VIEWS_IN_DEV !== 'true') return '-- views';
  const n = allViewCounts[slug] || 0;
  return `${n.toLocaleString()} ${n === 1 ? 'view' : 'views'}`;
};
const monthYear = (date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const eyebrow = (post) =>
  post.data.series ? `Series · ${post.data.series.name} · Part ${post.data.series.order}` : post.data.category;
const tagCounts = new Map();
blogEntriesWithReadingTime.forEach((post) =>
  (post.data.tags || []).forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1)),
);
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12).map(([tag]) => tag);

// SEO configuration for the blog page
const seoConfig = {
  title: 'My MetaData - Blog & Learning Notes',
  description:
    "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
  canonical: new URL('blog', Astro.site).toString(),
  openGraph: {
    basic: {
      title: 'My MetaData - Blog & Learning Notes',
      type: 'website',
      image: '/og-blog.jpg', // Add your blog's Open Graph image
      url: new URL('blog', Astro.site).toString(),
    },
    optional: {
      description:
        "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
      siteName: 'My MetaData',
    },
    image: {
      alt: 'My MetaData Blog - Learning and Development Resources',
    },
  },
  twitter: {
    creator: '@nerajno', // Replace with your Twitter handle
    site: '@nerajno', // Replace with your site's Twitter handle
    card: 'summary_large_image',
  },
};
---

<Layout title='Blog' surface='teach'>
  <SEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={{
      // Additional meta tags with GEO optimization
      meta: [
        { name: 'robots', content: 'index, follow' },
        { name: 'author', content: 'Nerando Johnson' },
        {
          name: 'keywords',
          content:
            'blog, programming, web development, learning, technology, tutorials',
        },
        { property: 'article:author', content: 'Nerando Johnson' },
        { property: 'article:section', content: 'Technology' },
        { property: 'og:locale', content: 'en_US' },
        { name: 'theme-color', content: '#1e293b' },
        // Additional meta tags (GEO, OpenGraph profile, etc.)
        { name: 'geo.region', content: 'US-GA' },
        { name: 'geo.placename', content: 'Atlanta' },
        { property: 'profile:first_name', content: 'Nerando' },
        { property: 'profile:last_name', content: 'Johnson' },
      ],
      // JSON-LD structured data
      link: [
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'My MetaData Blog RSS',
          href: '/rss.xml',
        },
      ],
    }}
  />

  <!-- JSON-LD Structured Data for Blog with GEO optimization -->
  <script
    type='application/ld+json'
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'My MetaData Blog',
      description:
        "Notes and blog posts created from things I've learned. All these articles I've written that helped me level up my skills and knowledge. Discover insights on web development, programming, and technology.",
      url: new URL('blog', Astro.site).toString(),
      author: {
        '@type': 'Person',
        name: 'Nerando Johnson',
        url: Astro.site?.toString(),
        jobTitle: 'Software Engineer',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Atlanta',
          addressRegion: 'GA',
          addressCountry: 'US',
        },
        sameAs: [
          'https://github.com/Nerajno',
          'https://twitter.com/nerajno',
          'https://www.linkedin.com/in/nerando-johnson/',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'My MetaData',
        url: Astro.site?.toString(),
      },
      blogPost: blogEntriesWithReadingTime.slice(0, 10).map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        description: post.data.description || post.data.snippet,
        url: new URL(`blog/${post.id.replace(/\.(md|mdx)$/, '')}`, Astro.site).toString(),
        datePublished: post.data.publishDate.toISOString(),
        dateModified:
          post.data.updatedDate?.toISOString() ||
          post.data.publishDate.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Nerando Johnson',
        },
        image: post.data.image?.src,
        articleSection: post.data.category,
      })),
    })}
  />

  <Container>
    <header class='pt-14'>
      <p class='font-mono text-xs uppercase tracking-wider text-soft'>Teach surface · font: sans · density: 1× · hue: 168</p>
      <h1 class='mt-2 font-heading text-4xl md:text-5xl font-bold tracking-tight text-strong'>My MetaData</h1>
      <p class='mt-3 max-w-2xl text-lg leading-relaxed text-soft'>
        {blogEntriesWithReadingTime.length} posts of learning in public: Vue, the craft around it, and the career that code built. Progress over perfection.
      </p>
    </header>

    <section aria-label='Featured post' id='featured-post' class='mt-10'>
      <article class='flex flex-wrap items-center gap-8 rounded-xl border border-surface bg-surface-card p-6 md:p-8'>
        <Picture
          src={featuredPost.data.image.src}
          alt={featuredPost.data.image.alt}
          sizes='(max-width: 800px) 100vw, 420px'
          width={640}
          height={400}
          format='webp'
          quality={80}
          loading='eager'
          class='aspect-[16/10] w-full flex-[1_1_16rem] rounded-lg object-cover'
        />
        <div class='min-w-0 flex-[999_1_26rem]'>
          <p class='text-xs font-medium uppercase tracking-wider text-accent'>Featured · {eyebrow(featuredPost)}</p>
          <h2 class='mt-2 font-heading text-2xl md:text-3xl font-bold leading-tight text-strong'>
            <a href={`/blog/${slugOf(featuredPost)}`} class='hover:text-accent hover:underline'>{featuredPost.data.title}</a>
          </h2>
          <p class='mt-3 leading-relaxed text-body'>{featuredPost.data.snippet}</p>
          <p class='mt-3 text-sm text-soft'>
            <time datetime={featuredPost.data.publishDate.toISOString()}>{monthYear(featuredPost.data.publishDate)}</time>
            {' · '}{featuredPost.minutesRead}{' · '}
            <span class='view-counter-display' data-slug={slugOf(featuredPost)}><span class='view-count-text'>{viewsLabel(slugOf(featuredPost))}</span></span>
          </p>
        </div>
      </article>
    </section>

    <div class='mt-10 flex flex-wrap gap-12 pb-16'>
      <div class='min-w-0 flex-[999_1_34rem]'>
        <div class='flex flex-wrap gap-4' role='search'>
          <div class='min-w-0 flex-[2_1_16rem]'>
            <label for='search' class='block text-sm font-medium text-body'>Search posts</label>
            <input
              type='search'
              id='search'
              class='mt-1 min-h-11 w-full rounded-lg border border-surface-strong bg-surface-card px-4 text-body placeholder:text-muted'
              placeholder='Search by title or tags…'
            />
          </div>
          <div class='min-w-0 flex-[1_1_12rem]'>
            <label for='series-filter' class='block text-sm font-medium text-body'>Series</label>
            <select id='series-filter' class='mt-1 min-h-11 w-full rounded-lg border border-surface-strong bg-surface-card px-3 text-body'>
              <option value=''>All posts</option>
              {allSeries.map((series) => <option value={series}>{series}</option>)}
            </select>
          </div>
        </div>
        <p class='sr-only' aria-live='polite' id='blog-status'></p>

        <ul id='blog-posts' class='mt-6 list-none p-0'>
          {
            blogEntriesWithReadingTime.map((post) => (
              <li
                class='blog-post-item border-t border-surface py-5'
                data-series={post.data.series?.name || ''}
                data-featured={post.id === featuredPost.id ? 'true' : undefined}>
                <p class='text-xs font-medium uppercase tracking-wider text-accent'>{eyebrow(post)}</p>
                <h2 class='mt-1 font-heading text-xl md:text-2xl font-semibold leading-snug text-strong'>
                  <a href={`/blog/${slugOf(post)}`} class='hover:text-accent hover:underline'>{post.data.title}</a>
                </h2>
                <p class='mt-1.5 leading-relaxed text-soft'>{post.data.snippet}</p>
                <p class='mt-1.5 text-sm text-soft'>
                  <time datetime={post.data.publishDate.toISOString()}>{monthYear(post.data.publishDate)}</time>
                  {' · '}{post.minutesRead}{' · '}
                  <span class='view-counter-display' data-slug={slugOf(post)}><span class='view-count-text'>{viewsLabel(slugOf(post))}</span></span>
                </p>
                {post.data.tags?.length > 0 && <span hidden data-tags={post.data.tags.join(',')} />}
              </li>
            ))
          }
        </ul>
        <p id='no-results' class='border-t border-surface py-6 text-soft' hidden>No posts match that search.</p>

        <nav aria-label='Pagination' id='pagination-controls' class='flex flex-wrap items-center gap-2 pt-6' hidden>
          <button type='button' id='prev-page' class='min-h-11 rounded-lg border border-surface-strong px-4 text-sm font-medium text-body hover:bg-surface-alt disabled:opacity-50'>← Previous</button>
          <span id='page-numbers' class='flex flex-wrap gap-2'></span>
          <button type='button' id='next-page' class='min-h-11 rounded-lg border border-surface-strong px-4 text-sm font-medium text-body hover:bg-surface-alt disabled:opacity-50'>Next →</button>
          <span id='page-info' class='sr-only'>Page 1 of 1</span>
        </nav>
      </div>

      <aside class='flex flex-[1_1_16rem] flex-col gap-4 md:max-w-xs' aria-label='Blog sidebar'>
        <section aria-labelledby='series-heading' class='rounded-xl border border-surface bg-surface-card p-5'>
          <h2 id='series-heading' class='font-semibold text-strong'>Series</h2>
          <ul class='mt-3 flex flex-col gap-2 text-sm'>
            {
              allSeries.map((name) => (
                <li>
                  <a href={`/series/${seriesSlug(name)}`} class='text-accent hover:underline'>
                    {name} — {seriesMap.get(name).length} {seriesMap.get(name).length === 1 ? 'part' : 'parts'}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby='topics-heading' class='rounded-xl border border-surface bg-surface-card p-5'>
          <h2 id='topics-heading' class='font-semibold text-strong'>Topics</h2>
          <ul class='mt-3 flex flex-wrap gap-2'>
            {
              topTags.map((tag) => (
                <li>
                  <button type='button' class='topic-chip min-h-9 rounded border border-surface bg-surface-alt px-2.5 font-mono text-xs text-body hover:border-surface-strong' data-tag={tag}>
                    {tag}
                  </button>
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-label='RSS' class='rounded-xl bg-surface-alt p-5 text-sm'>
          <p class='leading-relaxed text-body'>Posts land on dev.to too, but this is the canonical home.</p>
          <a href='/rss.xml' class='mt-2 inline-flex min-h-11 items-center font-semibold text-accent hover:underline'>RSS feed →</a>
        </section>
      </aside>
    </div>

    <script>
      const searchInput = document.getElementById('search') as HTMLInputElement;
      const seriesFilter = document.getElementById('series-filter') as HTMLSelectElement;
      const featured = document.getElementById('featured-post');
      const noResults = document.getElementById('no-results');
      const status = document.getElementById('blog-status');
      const nav = document.getElementById('pagination-controls');
      const pageNumbers = document.getElementById('page-numbers');
      const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
      const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
      const pageInfo = document.getElementById('page-info');
      const postsPerPage = 7;
      // Every post element, captured once. Filtering only toggles `hidden`,
      // so nothing is ever removed from the DOM (#373).
      const allPosts = Array.from(document.querySelectorAll<HTMLElement>('#blog-posts > li'));
      let matches: HTMLElement[] = [];
      let currentPage = 1;

      function render() {
        const totalPages = Math.max(1, Math.ceil(matches.length / postsPerPage));
        currentPage = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * postsPerPage;
        allPosts.forEach((post) => (post.hidden = true));
        matches.slice(start, start + postsPerPage).forEach((post) => (post.hidden = false));
        if (noResults) noResults.hidden = matches.length > 0;
        if (nav) nav.hidden = totalPages <= 1;
        if (pageInfo) pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;
        if (pageNumbers) {
          pageNumbers.replaceChildren(
            ...Array.from({ length: totalPages }, (_, i) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.textContent = String(i + 1);
              b.className =
                'min-h-11 min-w-11 rounded-lg border border-surface-strong px-3 text-sm font-medium text-body hover:bg-surface-alt aria-[current=page]:border-transparent aria-[current=page]:bg-accent aria-[current=page]:text-surface';
              if (i + 1 === currentPage) b.setAttribute('aria-current', 'page');
              b.setAttribute('aria-label', `Page ${i + 1}`);
              b.addEventListener('click', () => goTo(i + 1));
              return b;
            }),
          );
        }
      }

      function goTo(page: number) {
        currentPage = page;
        render();
        document.getElementById('blog-posts')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function filter() {
        const term = searchInput.value.toLowerCase().trim();
        const series = seriesFilter.value;
        const active = Boolean(term || series);
        if (featured) featured.hidden = active;
        matches = allPosts.filter((post) => {
          if (!active && post.dataset.featured) return false; // shown in the Featured card instead
          if (series && post.dataset.series !== series) return false;
          if (!term) return true;
          const title = post.querySelector('h2')?.textContent?.toLowerCase() || '';
          const tags = post.querySelector('[data-tags]')?.getAttribute('data-tags')?.toLowerCase() || '';
          return title.includes(term) || tags.includes(term);
        });
        currentPage = 1;
        render();
        if (status) status.textContent = active ? `${matches.length} ${matches.length === 1 ? 'post' : 'posts'} found` : '';
      }

      let timer: ReturnType<typeof setTimeout>;
      searchInput.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(filter, 300);
      });
      seriesFilter.addEventListener('change', filter);
      prevBtn.addEventListener('click', () => goTo(currentPage - 1));
      nextBtn.addEventListener('click', () => goTo(currentPage + 1));
      document.querySelectorAll<HTMLButtonElement>('.topic-chip').forEach((chip) =>
        chip.addEventListener('click', () => {
          searchInput.value = chip.dataset.tag || '';
          filter();
          searchInput.focus();
        }),
      );

      // Refresh view counts client-side (server values are a fallback).
      // One request at a time, as before: ~40 parallel calls swamp the API.
      // The featured post's slug appears twice (card + list), so fetch once per slug.
      (async () => {
        const counters = Array.from(document.querySelectorAll<HTMLElement>('.view-counter-display'));
        const slugs = [...new Set(counters.map((c) => c.dataset.slug).filter(Boolean))];
        for (const slug of slugs) {
          try {
            const data = await (await fetch(`/api/views/${slug}`)).json();
            if (data.count === undefined) continue;
            const label = `${data.count.toLocaleString()} ${data.count === 1 ? 'view' : 'views'}`;
            counters
              .filter((c) => c.dataset.slug === slug)
              .forEach((c) => {
                const textEl = c.querySelector('.view-count-text');
                if (textEl) textEl.textContent = label;
              });
          } catch (err) {
            console.error(`Failed to fetch view count for ${slug}:`, err);
          }
        }
      })();

      filter();
    </script>
  </Container>
</Layout>
