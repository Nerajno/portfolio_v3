---
import Layout from '../layouts/Layout.astro';
import Container from '../components/container.astro';
import Sectionhead from '../components/sectionhead.astro';
import EventList from '../components/eventlist.astro';
import Podcastcard from '../components/podcastcard.astro';
import { speakingData, podcastData } from '../data/speakingData';
import type { ProcessedEvent, ProcessedPodcast } from '../types';

// Process and sort events
const now = new Date();

const processedEvents: ProcessedEvent[] = speakingData.map((event) => {
  const eventDate = new Date(event.date);
  if (isNaN(eventDate.getTime())) {
    throw new Error(`Invalid date for event: ${event.title}`);
  }
  return {
    ...event,
    status: eventDate > now ? 'upcoming' : 'past',
  };
});

// Process podcasts
const processedPodcasts: ProcessedPodcast[] = podcastData.map((podcast) => {
  const podcastDate = new Date(podcast.date);
  if (isNaN(podcastDate.getTime())) {
    throw new Error(`Invalid date for podcast: ${podcast.title}`);
  }
  return {
    ...podcast,
    status: podcastDate > now ? 'upcoming' : 'past',
  };
});
---

<Layout title='Speaking Engagements'>
  <Container>
    <Sectionhead>
      <Fragment slot='title'>Speaking Engagements</Fragment>
      <Fragment slot='desc' class='text-slate-500 dark:text-slate-400'>
        Join me at upcoming events or explore past presentations.
      </Fragment>
    </Sectionhead>

    <img
      src='/other_images/Speaker_me.jpeg'
      alt='Photo of the speaker giving a presentation at an event'
      class='mx-auto w-full max-w-md h-auto mt-16 rounded-lg shadow'
    />

    <div class='flex flex-col gap-3 mx-auto max-w-4xl mt-16'>
      <p class='text-lg leading-relaxed text-slate-500 dark:text-slate-400'>
        I regularly speak at conferences, meetups and do some workshops at the
        intersection of software development, my developer experience, and
        creating inclusive tech communities. I also have links to podcasts and
        videos of "podcast~ish" content that I have done. Below you'll find my
        upcoming speaking engagements, podcasts, and past events.
      </p>
    </div>

    <div class='mx-auto max-w-4xl mt-12'>
      <EventList events={processedEvents} />
    </div>

    {processedPodcasts.length > 0 && (
      <div class='mx-auto max-w-4xl mt-20'>
        <button
          id='podcastToggle'
          class='flex items-center justify-between w-full text-left group'
          aria-expanded='false'
          aria-controls='podcastContent'
        >
          <div>
            <h2 class='text-3xl font-bold mb-2 animate-pulse text-blue-600 dark:text-blue-400 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors'>
              Podcasts
            </h2>
            <p class='text-lg leading-relaxed text-slate-500 dark:text-slate-400'>
              Podcasts I have done or been a guest on. 
            </p>
          </div>
          <svg
            id='toggleIcon'
            class='w-6 h-6 text-gray-500 dark:text-gray-400 transform transition-transform duration-200'
            fill='none'
            stroke='currentColor'
            viewBox='0 0 24 24'
            xmlns='http://www.w3.org/2000/svg'
          >
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M19 9l-7 7-7-7'/>
          </svg>
        </button>

        <div
          id='podcastContent'
          class='hidden overflow-hidden transition-all duration-300 ease-in-out max-h-[2000px] mt-6'
        >
          <div class='space-y-6 pt-4'>
            {processedPodcasts.map((podcast) => (
              <Podcastcard
                {...podcast}
                imageUrl={podcast.imageUrl || '/default-image.jpg'}
                imageAlt={podcast.imageAlt || podcast.title}
              />
            ))}
          </div>
        </div>
      </div>
    )}
  </Container>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.getElementById('podcastToggle');
    const content = document.getElementById('podcastContent');
    const toggleIcon = document.getElementById('toggleIcon');
    const toggleText = document.getElementById('toggleText');

    if (toggleButton && content && toggleIcon && toggleText) {
      toggleButton.addEventListener('click', () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        toggleButton.setAttribute('aria-expanded', String(!isExpanded));
        content.classList.toggle('hidden');
        toggleIcon.classList.toggle('rotate-180');
        toggleText.textContent = isExpanded ? 'view all' : 'hide';
      });
    }
  });
</script>


