---
import { SEO as AstroSEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Projectcard from '@components/projectcard.astro';
import Learningprojectcard from '@components/learningprojectcard.astro';
import projectsData from '../data/projects.js';
import { buildCollectionSchema, sanitizeSchema } from '@lib/schema';
// Combine all projects
const allProjects = [
  ...projectsData.showcase_projects.filter(
    (project) => project.visible !== false,
  ),
  ...projectsData.completed_projects.filter(
    (project) => project.visible !== false,
  ),
];

// Extract all unique tags from projects
const allTags = [
  ...new Set(allProjects.flatMap((project) => project.tags)),
].sort();

// Enhanced SEO Configuration with GEO optimization
const seoConfig = {
  title:
    "Portfolio Projects | Nerando Johnson - Software Engineer Case Studies",
  description:
    "Explore detailed case studies of technical projects, problem-solving processes, and real-world impact by Nerando Johnson. Vue3, React, and JavaScript development projects.",
  canonical: "https://developingdvlpr.com/portfolio",
  openGraph: {
    basic: {
      title: "Portfolio Projects | Nerando Johnson",
      type: "website",
      image: "https://developingdvlpr.com/images/og-portfolio.jpg",
      url: "https://developingdvlpr.com/portfolio",
    },
    optional: {
      description:
        "Explore detailed case studies of technical projects, problem-solving processes, and real-world impact. Vue3, React, JavaScript development.",
      siteName: "Developing Developer",
      locale: "en_US",
    },
  },
  twitter: {
    card: "summary_large_image" as const,
    site: "@nerajno",
    creator: "@nerajno",
    title: "Portfolio Projects | Nerando Johnson",
    description:
      "Explore detailed case studies of technical projects by Nerando Johnson. Vue3, React, and JavaScript development.",
    image: "https://developingdvlpr.com/images/og-portfolio.jpg",
  },
  extend: {
    meta: [
      {
        name: "keywords",
        content:
          "portfolio, projects, case studies, developer, Nerando Johnson, Vue3, React, JavaScript, front-end development, software development",
      },
      { name: "author", content: "Nerando Johnson" },
      { name: "robots", content: "index, follow" },
      { property: "og:locale", content: "en_US" },
      { name: "theme-color", content: "#1e293b" },
      { name: "geo.region", content: "US-GA" },
      { name: "geo.placename", content: "Atlanta" },
      // GEO-specific meta tags
      { property: "profile:first_name", content: "Nerando" },
      { property: "profile:last_name", content: "Johnson" },
      { property: "profile:username", content: "nerajno" },
    ],
  },
};

const structuredData = buildCollectionSchema({
  name: "Portfolio Projects — Nerando Johnson",
  url: new URL('/portfolio', 'https://developingdvlpr.com').toString(),
  items: allProjects.slice(0, 10).map((project) => ({
    name: project.name ?? project.title,
    // Only real destinations: case study, then live site, then repo, else the card itself
    url: new URL(
      project.caseStudyUrl ?? project.website ?? project.github ?? `/portfolio#${project.id}`,
      'https://developingdvlpr.com',
    ).toString(),
  })),
});
---

<AstroSEO
  title={seoConfig.title}
  description={seoConfig.description}
  canonical={seoConfig.canonical}
  openGraph={seoConfig.openGraph}
  twitter={seoConfig.twitter}
  extend={seoConfig.extend}
/>

<!-- AEO: CollectionPage + ItemList -->
<script type='application/ld+json' set:html={sanitizeSchema(structuredData)} />

<Layout title="Projects">
  <Container>
    <header class="max-w-screen-lg mx-auto pt-14">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Proof of work</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-strong">Projects with case studies</h1>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-soft">
        Outcomes first. Every card links to a live demo, the repo, and a deep dive on the tradeoffs,
        or says plainly what is still pending.
      </p>
    </header>

    <!-- Tag filter -->
    <section aria-label="Filter projects by technology" class="max-w-screen-lg mx-auto mt-8">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Technology filters">
        <button
          type="button"
          id="clear-filters"
          aria-pressed="true"
          class="filter-chip min-h-11 rounded-full border border-surface-strong px-4 text-sm font-medium text-body hover:bg-surface-alt aria-pressed:border-transparent aria-pressed:bg-accent aria-pressed:text-surface">
          All
        </button>
        {
          allTags.map((tag) => (
            <button
              type="button"
              aria-pressed="false"
              class="tag-filter-btn filter-chip min-h-11 rounded-full border border-surface-strong px-4 text-sm font-medium text-body hover:bg-surface-alt aria-pressed:border-transparent aria-pressed:bg-accent aria-pressed:text-surface"
              data-tag={tag.toLowerCase()}>
              {tag}
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" id="filter-status"></p>
    </section>

    <!-- Projects grid -->
    <div class="grid md:grid-cols-2 gap-6 mx-auto max-w-screen-lg mt-8" id="projects-grid">
      {
        allProjects.map((project) => (
          <div
            class="project-item"
            data-tags={project.tags.map((tag) => tag.toLowerCase()).join(",")}>
            <Projectcard project={project} />
          </div>
        ))
      }
    </div>
  </Container>

  <!-- Learning projects band -->
  <section aria-labelledby="learning-heading" class="mt-14 bg-surface-alt">
    <Container>
      <div class="max-w-screen-lg mx-auto flex flex-wrap items-center justify-between gap-4 py-8">
        <div>
          <h2 id="learning-heading" class="text-xl font-semibold text-strong">Learning projects</h2>
          <p class="mt-1 text-sm text-soft">
            Smaller builds from the learning garden, kept separate from production artifacts on purpose.
          </p>
        </div>
        <button
          type="button"
          id="toggle-learning-showcase"
          aria-expanded="false"
          aria-controls="learning-showcase-section"
          class="min-h-11 rounded-lg border border-surface-strong bg-surface-card px-5 text-sm font-semibold text-body hover:bg-surface">
          Show learning projects
        </button>
      </div>

      <div class="max-w-screen-lg mx-auto pb-10" id="learning-showcase-section" hidden>
        <p class="max-w-3xl text-soft">
          A collection of smaller projects built for learning new technologies, patterns, or concepts.
          Each project details the motivation, process, and lessons learned.
        </p>
        <div class="grid md:grid-cols-2 gap-10 mt-8">
          {
            projectsData.learning_projects
              .filter((project) => project.visible !== false)
              .map((project) => <Learningprojectcard project={project} />)
          }
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <!-- Call to action -->
    <section aria-labelledby="more-heading" class="max-w-screen-lg mx-auto my-16 rounded-xl border border-surface bg-surface-card p-8 text-center">
      <h2 id="more-heading" class="text-2xl font-bold text-strong">Want to see more?</h2>
      <p class="mx-auto mt-3 max-w-2xl text-soft">
        Each project represents the process of problem-solving, technical decision-making, and iterative
        improvement (this applies to learning projects and Learnt). The case studies dive deep into the
        "why" and "how" behind each solution.
      </p>
      <div class="mt-6 flex flex-col md:flex-row justify-center gap-3">
        <a href="/contact" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-accent px-6 font-semibold text-surface hover:bg-accent-hover">
          Let's discuss my work
        </a>
        <a href="/about" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-surface-strong px-6 font-semibold text-body hover:bg-surface-alt">
          Learn about my process
        </a>
        <a
          href="https://learnt.developingdvlpr.com/"
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-surface-strong px-6 font-semibold text-body hover:bg-surface-alt"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="Learnt, my learning project collection (opens in a new tab)">
          Learnt ↗
        </a>
      </div>
    </section>
  </Container>

  <style>
    .project-item {
      transition:
        opacity 0.3s ease,
        transform 0.3s ease;
    }

    .project-item.hidden {
      opacity: 0;
      transform: scale(0.95);
      pointer-events: none;
    }

    .project-item:hover {
      transform: translateY(-2px);
    }

    .project-item.hidden:hover {
      transform: scale(0.95);
    }
  </style>

  <script>
    const filterButtons = document.querySelectorAll(".tag-filter-btn");
    const projectItems = document.querySelectorAll(".project-item");
    const allButton = document.getElementById("clear-filters");
    const status = document.getElementById("filter-status");
    const selectedTags = new Set();

    function update() {
      let shown = 0;
      projectItems.forEach((item) => {
        const tags = (item.getAttribute("data-tags") || "").split(",");
        const visible = selectedTags.size === 0 || tags.some((tag) => selectedTags.has(tag));
        item.classList.toggle("hidden", !visible);
        if (visible) shown++;
      });
      allButton?.setAttribute("aria-pressed", String(selectedTags.size === 0));
      if (status) status.textContent = `Showing ${shown} of ${projectItems.length} projects`;
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.getAttribute("data-tag");
        const on = !selectedTags.has(tag);
        on ? selectedTags.add(tag) : selectedTags.delete(tag);
        button.classList.toggle("active", on);
        button.setAttribute("aria-pressed", String(on));
        update();
      });
    });

    allButton?.addEventListener("click", () => {
      selectedTags.clear();
      filterButtons.forEach((btn) => {
        btn.classList.remove("active");
        btn.setAttribute("aria-pressed", "false");
      });
      update();
    });

    const toggleButton = document.getElementById("toggle-learning-showcase");
    const showcaseSection = document.getElementById("learning-showcase-section");
    toggleButton?.addEventListener("click", () => {
      const open = showcaseSection.hidden;
      showcaseSection.hidden = !open;
      toggleButton.setAttribute("aria-expanded", String(open));
      toggleButton.textContent = open ? "Hide learning projects" : "Show learning projects";
    });
  </script>
</Layout>
