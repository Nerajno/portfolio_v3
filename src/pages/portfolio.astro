---
import { SEO as AstroSEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import Projectcard from '@components/projectcard.astro';
import Learningprojectcard from '@components/learningprojectcard.astro';
import projectsData from '../data/projects.js';
// Combine all projects
const allProjects = [
  ...projectsData.showcase_projects.filter(
    (project) => project.visible !== false
  ),
  ...projectsData.completed_projects.filter(
    (project) => project.visible !== false
  ),
];

// Extract all unique tags from projects
const allTags = [
  ...new Set(allProjects.flatMap((project) => project.tags)),
].sort();

// Enhanced SEO Configuration with GEO optimization
const seoConfig = {
  title: "Portfolio Projects | Nerando Johnson - Software Developer Case Studies",
  description: "Explore detailed case studies of technical projects, problem-solving processes, and real-world impact by Nerando Johnson. Vue3, React, and JavaScript development projects.",
  canonical: "https://developingdvlpr.com/portfolio",
  openGraph: {
    basic: {
      title: "Portfolio Projects | Nerando Johnson",
      type: "website",
      image: "https://developingdvlpr.com/images/og-portfolio.jpg",
      url: "https://developingdvlpr.com/portfolio",
    },
    optional: {
      description: "Explore detailed case studies of technical projects, problem-solving processes, and real-world impact. Vue3, React, JavaScript development.",
      siteName: "Developing Developer",
      locale: "en_US",
    },
  },
  twitter: {
    card: "summary_large_image",
    site: "@nerajno",
    creator: "@nerajno",
    title: "Portfolio Projects | Nerando Johnson",
    description: "Explore detailed case studies of technical projects by Nerando Johnson. Vue3, React, and JavaScript development.",
    image: "https://developingdvlpr.com/images/og-portfolio.jpg"
  },
  extend: {
    meta: [
      { name: "keywords", content: "portfolio, projects, case studies, developer, Nerando Johnson, Vue3, React, JavaScript, front-end development, software development" },
      { name: "author", content: "Nerando Johnson" },
      { name: "robots", content: "index, follow" },
      { property: "og:locale", content: "en_US" },
      { name: "theme-color", content: "#1e293b" },
      { name: "geo.region", content: "US-GA" },
      { name: "geo.placename", content: "Atlanta" },
      // GEO-specific meta tags
      { property: "profile:first_name", content: "Nerando" },
      { property: "profile:last_name", content: "Johnson" },
      { property: "profile:username", content: "nerajno" },
    ],
  },
};

// Structured data for GEO optimization
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Portfolio Projects - Nerando Johnson",
  description: "A collection of software development projects with detailed case studies showcasing problem-solving, technical decisions, and measurable outcomes.",
  url: "https://developingdvlpr.com/portfolio",
  author: {
    "@type": "Person",
    name: "Nerando Johnson",
    url: "https://developingdvlpr.com",
    jobTitle: "Software Developer",
    email: "nerando@developingdvlpr.com",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Atlanta",
      addressRegion: "GA",
      addressCountry: "US",
    },
    knowsAbout: [
      "Vue3",
      "React",
      "JavaScript",
      "Front-End Development",
      "Software Architecture",
      "Web Development",
    ],
    sameAs: [
      "https://github.com/Nerajno",
      "https://twitter.com/nerajno",
      "https://www.linkedin.com/in/nerando-johnson/",
    ],
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allProjects.slice(0, 10).map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "CreativeWork",
        name: project.title,
        description: project.description,
        url: `https://developingdvlpr.com/case-study/${project.id}`,
        author: {
          "@type": "Person",
          name: "Nerando Johnson",
        },
      },
    })),
  },
};
---

<AstroSEO
  title={seoConfig.title}
  description={seoConfig.description}
  canonical={seoConfig.canonical}
  openGraph={seoConfig.openGraph}
  twitter={seoConfig.twitter}
  extend={seoConfig.extend}
/>

<!-- Structured Data for GEO -->
<script type='application/ld+json' set:html={JSON.stringify(structuredData)} />


<Layout title='Projects'>
  <Container>
    <Sectionhead>
      <Fragment slot='title'>Projects with Case Studies</Fragment>
      <Fragment slot='desc'>
        A detailed breakdown of my technical projects, showcasing the
        problem-solving process, technical decisions, and measurable outcomes
        that demonstrate real-world impact.
      </Fragment>
    </Sectionhead>

    <!-- Why Case Studies Matter Section -->
    <div class='max-w-screen-lg mx-auto mt-8 mb-12'>
      <div
        class='bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 rounded-xl p-6 border border-blue-100 dark:border-gray-600'>
        <h3
          class='text-xl font-semibold mb-4 text-center text-gray-900 dark:text-white'>
          Beyond Just Code: An Evidence and Impact Approach
        </h3>
        <div class='grid md:grid-cols-3 gap-6'>
          <div class='text-center'>
            <div
              class='w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mx-auto mb-3'>
              <svg
                class='w-6 h-6 text-blue-600 dark:text-blue-400'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
                ></path>
              </svg>
            </div>
            <h4 class='font-semibold text-gray-900 dark:text-white mb-2'>
              Problem-Solving Process
            </h4>
            <p class='text-gray-600 dark:text-gray-300 text-sm'>
              How I approach complex challenges and make technical decisions.
            </p>
          </div>
          <div class='text-center'>
            <div
              class='w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mx-auto mb-3'>
              <svg
                class='w-6 h-6 text-green-600 dark:text-green-400'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
                ></path>
              </svg>
            </div>
            <h4 class='font-semibold text-gray-900 dark:text-white mb-2'>
              Measurable Impact
            </h4>
            <p class='text-gray-600 dark:text-gray-300 text-sm'>
              Real metrics and outcomes that demonstrate value delivered.
            </p>
          </div>
          <div class='text-center'>
            <div
              class='w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mx-auto mb-3'>
              <svg
                class='w-6 h-6 text-purple-600 dark:text-purple-400'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M13 10V3L4 14h7v7l9-11h-7z'></path>
              </svg>
            </div>
            <h4 class='font-semibold text-gray-900 dark:text-white mb-2'>
              Technical Depth
            </h4>
            <p class='text-gray-600 dark:text-gray-300 text-sm'>
              Architecture decisions, trade-offs, and lessons learned
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tag Filter Section -->
    <div class='max-w-screen-lg mx-auto mt-8 mb-8'>
      <h3 class='text-lg font-semibold mb-4 text-center'>
        Filter by Technology:
      </h3>
      <div class='flex flex-wrap justify-center gap-2 mb-4'>
        <!-- Dynamic tag buttons -->
        {
          allTags.map((tag) => (
            <button
              class='tag-filter-btn px-4 py-2 rounded-xl border-2 border-gray-300 text-slate-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200'
              data-tag={tag.toLowerCase()}>
              {tag}
            </button>
          ))
        }
      </div>

      <!-- Clear filters button -->
      <div class='text-center'>
        <button
          id='clear-filters'
          class='px-6 py-2 border border-blue-600 text-blue-600 rounded-xl hover:bg-blue-100 dark:text-blue-400 dark:border-blue-400 dark:hover:bg-blue-900/50 transition-colors duration-300'>
          Clear All Filters
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div
      class='grid md:grid-cols-3 gap-10 mx-auto max-w-screen-lg mt-12'
      id='projects-grid'>
      {
        allProjects.map((project) => (
          <div
            class='project-item'
            data-tags={project.tags.map((tag) => tag.toLowerCase()).join(',')}>
            <Projectcard project={project} />
          </div>
        ))
      }
    </div>

    <!-- Learning Projects Showcase Toggle Button -->
    <div class='max-w-screen-lg mx-auto mt-10 text-center'>
      <button
        id='toggle-learning-showcase'
        class='px-6 py-2 border border-blue-600 text-blue-600 rounded-xl hover:bg-blue-100 dark:text-blue-400 dark:border-blue-400 dark:hover:bg-blue-900/50 transition-colors duration-300 mb-6'>
        Show Learning Projects
      </button>
    </div>

    <!-- Learning Projects Showcase -->
    <div
      class='max-w-screen-lg mx-auto mt-4'
      id='learning-showcase-section'
      style='display: none;'>
      <Sectionhead>
        <Fragment slot='title'>Learning Projects Showcase</Fragment>
        <Fragment slot='desc'>
          A collection of smaller projects built for learning new technologies,
          patterns, or new concepts. Each project details the motivation, process, and
          lessons learned.
        </Fragment>
      </Sectionhead>
      <div class='grid md:grid-cols-2 gap-10 mt-10'>
        {
          projectsData.learning_projects
            .filter((project) => project.visible !== false)
            .map((project) => <Learningprojectcard project={project} />)
        }
      </div>
    </div>

    <!-- Call to Action -->
    <div class='max-w-screen-lg mx-auto mt-10 text-center'>
      <div
        class='bg-white dark:bg-gray-800 rounded-xl p-8 shadow-sm border border-gray-200 dark:border-gray-700'>
        <h3 class='text-2xl font-bold text-gray-900 dark:text-white mb-4'>
          Want to See More?
        </h3>
        <p class='text-gray-600 dark:text-gray-300 mb-6 max-w-2xl mx-auto'>
          Each project represents the process of problem-solving, technical
          decision-making, and iterative improvement ( This applies to learning projects and Learnt). The case studies dive deep
          into the "why" and "how" behind each solution.
        <div class='flex flex-col md:flex-row justify-center gap-4'>
          <a
            href='/contact'
            class='w-full md:w-auto bg-blue-600 dark:bg-blue-800 text-white dark:text-slate-300 px-6 py-3 rounded-lg font-medium hover:bg-blue-700 dark:hover:bg-blue-900 transition-color text-center'>
            Let's Discuss My Work
          </a>
          <a
            href='/about'
            class='w-full md:w-auto border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center'>
            Learn About My Process
          </a>
          <a href="https://learnt.developingdvlpr.com/"
            class="w-full md:w-auto bg-blue-600 dark:bg-blue-800 text-white dark:text-slate-300 px-6 py-3 rounded-lg font-medium hover:bg-blue-700 dark:hover:bg-blue-900 transition-colors text-center"
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Visit Learnt website (opens in new tab)"
            title="Visit Learnt">
            Learnt ~ My Learning Project Collection
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .tag-filter-btn.active {
    background-color: #3b82f6;
    color: white;
    border-color: #3b82f6;
  }

  .tag-filter-btn:hover.active {
    background-color: #2563eb;
  }

  .project-item {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .project-item.hidden {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
  }

  .project-item:hover {
    transform: translateY(-2px);
  }

  .project-item.hidden:hover {
    transform: scale(0.95);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const filterButtons = document.querySelectorAll('.tag-filter-btn');
    const projectItems = document.querySelectorAll('.project-item');
    const clearButton = document.getElementById('clear-filters');

    const selectedTags = new Set();

    function updateProjectVisibility() {
      projectItems.forEach((item) => {
        const tagsAttr = item.getAttribute('data-tags');
        const projectTags = tagsAttr ? tagsAttr.split(',') : [];

        if (selectedTags.size === 0) {
          item.classList.remove('hidden');
          return;
        }

        const hasSelectedTag = projectTags.some((tag) => selectedTags.has(tag));

        if (hasSelectedTag) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const tag = this.getAttribute('data-tag');

        if (selectedTags.has(tag)) {
          selectedTags.delete(tag);
          this.classList.remove('active');
        } else {
          selectedTags.add(tag);
          this.classList.add('active');
        }

        updateProjectVisibility();
      });
    });

    if (clearButton) {
      clearButton.addEventListener('click', function () {
        selectedTags.clear();
        filterButtons.forEach((btn) => btn.classList.remove('active'));
        updateProjectVisibility();

        // Temporarily change to green
        clearButton.className =
          'px-6 py-2 border border-transparent bg-green-600 text-white rounded-xl hover:bg-green-700 transition-colors duration-300';

        // Revert back to the default blue outline style
        setTimeout(() => {
          clearButton.className =
            'px-6 py-2 border border-blue-600 text-blue-600 rounded-xl hover:bg-blue-100 dark:text-blue-400 dark:border-blue-400 dark:hover:bg-blue-900/50 transition-colors duration-300';
        }, 600);
      });
    }

    updateProjectVisibility();

    // Learning Showcase Toggle
    const toggleButton = document.getElementById('toggle-learning-showcase');
    const showcaseSection = document.getElementById(
      'learning-showcase-section'
    );
    let isShowcaseVisible = false;
    if (toggleButton && showcaseSection) {
      toggleButton.addEventListener('click', function () {
        isShowcaseVisible = !isShowcaseVisible;
        showcaseSection.style.display = isShowcaseVisible ? 'block' : 'none';
        toggleButton.textContent = isShowcaseVisible
          ? 'Hide Learning Projects Showcase'
          : 'Show Learning Projects Showcase';
      });
    }
  });
</script>
