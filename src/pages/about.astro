---
import Layout from "@layouts/Layout.astro";
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import { Image } from "astro:assets";
import Ava from "@assets/Banner_for_site.png"; // Adjust the path as needed
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About Me</Fragment>
      <Fragment slot="description">
        The ReadMe on my experiences, my work my learning and other fun stuff.
      </Fragment>
    </Sectionhead>

    <div class="max-w-4xl mx-auto mt-16">
      <div class="md:flex md:items-center gap-16 mb-10">
        <div class="text-pretty leading-9">
          <h2 class="text-4xl font-bold mb-4">Hi There , Nerando Here!</h2>
          <div class="text-lg text-slate-500">
            <p class="mb-4">
              I currently work as  Junior Front-end Engineer based in Atlanta. I love what I do and do my best to share what I know.
              <ul>
                <li>- Brief description about me technically and the things/skills I am passionately learning, links to learning garden.</li>
                <li>- Brief description about me personally as a learner</li>
                <li>- Brief description about me as a tech community facilitator, mentor, and speaker</li>
              </ul>
            </p>
          </div>
        </div>
        <Image
          src={Ava}
          alt="Muhammad Syakirurohman"
          width={300}
          class="rounded-3xl rotate-3 mx-4 md:mx-0"
        />
      </div>

      <div class="mt-12 text-lg text-slate-500">
        <p class="mb-6">
          - my interests and hobbies
        </p>
      </div>

    </div>
  </Container>
</Layout>
