---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import { Image } from 'astro:assets';
import Ava from '@assets/Banner_for_site.png'; // Adjust the path as needed
import { funFacts } from '../data/funFacts.js'; // Adjust the path as needed
import { AstroSEO } from 'astro-seo-plugin';

// Choose a fact based on the current day of the year
const today = new Date();
const dayOfYear = Math.floor(
  (today - new Date(today.getFullYear(), 0, 0)) / 1000 / 60 / 60 / 24
);
const factOfTheDay = funFacts[dayOfYear % funFacts.length];

// SEO Configuration
const seoConfig = {
  title:
    'About Nerando Johnson - Software Developer & Tech Community Builder & Consultant',
  description:
    'Learn about Nerando Johnson, a passionate junior front-end developer in Atlanta specializing in Vue3, and building impactful tech experiences. Discover my journey from curiosity to code.',
  canonical: 'https://developingdvlpr.com/about', // Update with your actual domain
  openGraph: {
    basic: {
      title: 'About Nerando Johnson - Software Developer',
      type: 'website',
      image: 'https://developingdvlpr.com/assets/Banner_for_site.png', // Update with your actual domain and image path
      url: 'https://developingdvlpr.com/about',
    },
    optional: {
      description:
        'Passionate software developer in Atlanta currently working in the front-end space. I currently specialize in Vue3, some open-source contributing, consulting, and mentorship. Building thoughtful tech experiences.',
      siteName: 'Developing Developer',
      locale: 'en_US',
    },
  },
  twitter: {
    card: 'summary_large_image',
    site: '@nerajno',
    creator: '@nerajno',
    title: 'About Nerando Johnson - Software Developer',
    description:
      'Front-end developer in Atlanta passionate about Vue3, some open-source contributing, consulting, and building impactful tech experiences.',
    image: 'https://developingdvlpr.com/assets/Banner_for_site.png', // Update with your actual domain
  },
  extend: {
    meta: [
      { name: 'author', content: 'Nerando Johnson' },
      {
        name: 'keywords',
        content:
          'front-end developer, software developer, Vue3, Atlanta developer, software engineer, open source, mentoring',
      },
      { name: 'robots', content: 'index, follow' },
      { property: 'og:locale', content: 'en_US' },
      { name: 'theme-color', content: '#1e293b' }, // Adjust to match your site's theme
    ],
  },
};
---

<Layout title='About'>
  <AstroSEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={seoConfig.extend}
  />

  <Container>
    <Sectionhead>
      <Fragment slot='title'>About Me</Fragment>
      <Fragment slot='desc'>
        A little bit about myself as a software professional, my learning and
        development journey and what I can do.
      </Fragment>
    </Sectionhead>

    <div class='max-w-4xl mx-auto mt-16'>
      <div class='md:flex md:items-center gap-16 mb-10'>
        <div class='text-pretty leading-9'>
          <h2 class='text-4xl font-bold mb-4'>Hey 👋, I'm Nerando Johnson</h2>
          <div class='text-lg text-slate-500 dark:text-slate-400'>
            <p class='mb-4'>
              I'm currently working in the capacity as junior front-end developer
              in Atlanta, among other things. I'm passionate about building
              thoughtful, impactful tech experiences. I work and learn at the
              intersection of code, design, creativity, problem solving, and
              community—crafting clean interfaces, solving real-world problems,
              and making some contributions to open-source projects.
            </p>
            <p class='mb-4'>
              My journey into tech wasn't a straight line. It started with
              curiosity — breaking things, learning how to fix them, and
              discovering a love for turning ideas into code. I have walked the
              path of hobbyist, mentee, freeCodecamp learner, technical
              consultant, tinkerer, bootcamp student, among many things. That
              curiosity evolved into a career where I now focus on front-end
              engineering, collaborative development, and helping others grow.
            </p>
            <p class='mb-4'>
              Check out my <a
                href='https://developingdvlpr.com/portfolio'
                class='animate-pulse text-blue-600 dark:text-blue-400 font-semibold hover:underline'
                target='_blank'
                rel='noopener'>portfolio</a
              > for featured work or MVPs that I have built. You can also find me
              on <a
                href='https://github.com/Nerajno'
                class='font-semibold hover:underline'
                target='_blank'
                rel='noopener'>GitHub</a
              >,
              <a
                href='https://twitter.com/nerajno'
                class='font-semibold hover:underline'
                target='_blank'
                rel='noopener'
                >Twitter &lt;= yes that's what I will always call it</a
              >, and
              <a
                href='https://www.linkedin.com/in/nerando-johnson/'
                class='font-semibold hover:underline'
                target='_blank'
                rel='noopener'>LinkedIn</a
              >.
            </p>
          </div>
        </div>
        <Image
          src={Ava}
          alt='Nerando Johnson'
          width={300}
          class='rounded-3xl rotate-3 mx-4 md:mx-0'
        />
      </div>

      <div class='mt-12 text-lg text-slate-500 dark:text-slate-400'>
        <p class='mb-6'>
          These days, I'm more focused on front-end development with frameworks
          like Vue3 and some React tooling, understanding and learning how build
          scalable tools, mentoring less experienced developers among other
          things. I believe great software is as much about people as it is
          about code as a solution to a problem .
        </p>
        <p>
          Outside of software development, I enjoy exploring new ideas,
          tinkering, and learning. I'm currently all about learning ( getting
          better at doing it in public: <a
            href='https://www.linkedin.com/in/nerando-johnson/recent-activity/all/'
            target='_blank'
            rel='noopener noreferrer'>here at LinkedIn</a
          > or <a
            href='https://developingdvlpr.com/blog'
            target='_blank'
            rel='noopener noreferrer'>here</a
          >), working with purpose, and building things that matter.
        </p>
      </div>

      <div
        class='mt-12 bg-slate-300 dark:bg-slate-700 p-6 rounded-xl shadow-sm border border-slate-500 dark:border-slate-400 text-slate-500 dark:text-slate-400'>
        <h3 class='text-2xl font-semibold mb-4'>Random Fact about Me</h3>
        <p>
          {factOfTheDay}
        </p>
      </div>
    </div>
  </Container>
</Layout>
