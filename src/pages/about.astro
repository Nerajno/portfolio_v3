---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import { Image } from 'astro:assets';
import Ava from '@assets/Banner_for_site.png';
import { funFacts } from '../data/funFacts.js';
import { speakingData } from '../data/speakingData';
import { SEO as AstroSEO } from 'astro-seo';
const today = new Date();
const dayOfYear = Math.floor(
  (today - new Date(today.getFullYear(), 0, 0)) / 1000 / 60 / 60 / 24
);
const factOfTheDay = funFacts[dayOfYear % funFacts.length];

// Enhanced SEO with GEO optimization
const seoConfig = {
  title: 'About Nerando Johnson - Software Engineer & Tech Community Builder & Consultant',
  description: 'Learn about Nerando Johnson, a passionate front-end software engineer in Atlanta specializing in Vue3, and building impactful tech experiences. Discover my journey from curiosity to code.',
  canonical: 'https://developingdvlpr.com/about',
  openGraph: {
    basic: {
      title: 'About Nerando Johnson - Software Engineer',
      type: 'website',
      image: 'https://developingdvlpr.com/assets/Banner_for_site.png',
      url: 'https://developingdvlpr.com/about',
    },
    optional: {
      description: 'Passionate software engineer in Atlanta currently working in the front-end space. I currently specialize in Vue3, some open-source contributing, consulting, and mentorship. Building thoughtful tech experiences.',
      siteName: 'Developing Developer',
      locale: 'en_US',
    },
  },
  twitter: {
    card: 'summary_large_image',
    site: '@nerajno',
    creator: '@nerajno',
    title: 'About Nerando Johnson - Software Engineer',
    description: 'Front-end developer in Atlanta passionate about Vue3, some open-source contributing, consulting, and building impactful tech experiences.',
    image: 'https://developingdvlpr.com/assets/Banner_for_site.png',
  },
  extend: {
    meta: [
      { name: 'author', content: 'Nerando Johnson' },
      { name: 'keywords', content: 'front-end developer, software developer, Vue3, Atlanta developer, software engineer, open source, mentoring' },
      { name: 'robots', content: 'index, follow' },
      { property: 'og:locale', content: 'en_US' },
      { name: 'theme-color', content: '#1e293b' },
      // GEO-specific meta tags
      { name: 'article:author', content: 'Nerando Johnson' },
      { property: 'profile:first_name', content: 'Nerando' },
      { property: 'profile:last_name', content: 'Johnson' },
    ],
  },
};

// Structured data for better AI understanding (GEO optimization)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nerando Johnson',
  url: 'https://developingdvlpr.com',
  image: 'https://developingdvlpr.com/assets/Banner_for_site.png',
  jobTitle: 'Front-End Software Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Software Development Industry',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Atlanta',
    addressRegion: 'GA',
    addressCountry: 'US',
  },
  alumniOf: 'freeCodeCamp, Bootcamp',
  knowsAbout: [
    'Vue3',
    'Nuxt',
    'JavaScript',
    'Front-End Development',
    'Open Source',
    'Mentorship',
    'Technical Consulting',
  ],
  sameAs: [
    'https://github.com/Nerajno',
    'https://twitter.com/nerajno',
    'https://www.linkedin.com/in/nerando-johnson/',
  ],
  description: 'Front-end software engineer in Atlanta specializing in Vue 3, TypeScript, and Nuxt, and building impactful tech experiences. Passionate about open-source contribution, mentorship, and community building.',
};

// Press & talks strip (#340): unique event names from past talks, newest first
const now = new Date();
const pastEvents = [
  ...new Set(
    speakingData
      .filter((talk) => new Date(talk.date) <= now)
      .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
      .map((talk) => talk.name)
  ),
].slice(0, 7);

// Uses (#340): only tools this site or the bio above already show in use
const uses = [
  { title: 'Build', items: 'Vue 3 · Nuxt · TypeScript · Tailwind · Astro · Supabase' },
  { title: 'Verify', items: 'Vitest · Playwright · Testing Library · axe · GitHub Actions' },
  { title: 'Ship & tell', items: 'Netlify · Dialects tokens · the blog' },
];

const eyebrow = 'text-sm font-semibold uppercase tracking-widest text-accent';
const pending = 'inline-flex items-center rounded border border-dashed border-surface-strong px-2 py-0.5 text-xs text-muted';
const card = 'rounded-xl border border-surface bg-surface-card p-6';
---

<Layout title='About'>
  <AstroSEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={seoConfig.extend}
  />

  <!-- Structured Data for GEO -->
  <script type='application/ld+json' set:html={JSON.stringify(structuredData)} />

  <Container>
    <section aria-labelledby='about-heading' class='flex flex-wrap items-start gap-12 pb-12 pt-14'>
      <div class='min-w-0 flex-[999_1_32rem]'>
        <p class={eyebrow}>About</p>
        <h1 id='about-heading' class='mt-2 text-4xl md:text-5xl font-bold tracking-tight text-strong'>
          Hey <span aria-hidden='true'>👋</span>, I'm Nerando Johnson
        </h1>
        <div class='mt-5 flex max-w-prose flex-col gap-4 text-lg leading-relaxed text-body'>
          <p>
            <strong class='text-strong'>Current role:</strong> Front-end software engineer based in Atlanta, GA,
            specializing in Vue 3, TypeScript, Nuxt, open-source contribution, technical consulting, and developer mentorship.
          </p>
          <p>
            I build thoughtful, impactful tech experiences at the intersection of code, design, creativity, problem-solving, and community.
          </p>
          <p>
            <strong class='text-strong'>Background:</strong> My path into technology started with curiosity: breaking things, learning how to fix them,
            and discovering a passion for turning ideas into code. Along the way I've been a hobbyist, mentee, freeCodeCamp learner,
            technical software consultant, tinkerer, and bootcamp graduate. That journey shaped my focus on software engineering,
            collaborative development, and helping others grow in tech.
          </p>
          <p>
            <strong class='text-strong'>Philosophy:</strong> Great software is equally about people and code. Effective solutions solve real problems for real users.
          </p>
        </div>
        <p class='mt-6 flex flex-wrap items-center gap-x-5 gap-y-2'>
          <a href='/portfolio' class='font-semibold'>See my work →</a>
          <a href='/blog' class='font-semibold'>Read the blog →</a>
          <span class={pending} data-pending='resume'>Résumé link pending</span>
        </p>
      </div>
      <div class='flex flex-[1_1_16rem] flex-col gap-4'>
        <Image
          src={Ava}
          alt='Professional photo of Nerando Johnson, front-end developer'
          width={320}
          class='w-full max-w-xs rounded-2xl'
        />
        <p class='font-mono text-xs uppercase leading-loose text-soft'>
          Atlanta, GA<br />Vue 3 · TypeScript · Nuxt<br />Learn → Build → Teach
        </p>
      </div>
    </section>
  </Container>

  <section aria-labelledby='press-heading' class='bg-surface-alt'>
    <Container>
      <div class='py-11'>
        <h2 id='press-heading' class={eyebrow}>Press &amp; talks</h2>
        <ul class='mt-4 flex list-none flex-wrap gap-x-7 gap-y-2 p-0 font-medium text-soft' id='press-strip'>
          {pastEvents.map((name) => <li>{name}</li>)}
        </ul>
        <a href='/speaking' class='mt-4 inline-block text-sm font-medium'>Full talk catalog →</a>
      </div>
    </Container>
  </section>

  <Container>
    <section aria-labelledby='testimonials-heading' class='py-14'>
      <p class={eyebrow}>Testimonials</p>
      <h2 id='testimonials-heading' class='mt-2 text-3xl font-bold text-strong'>What people say</h2>
      <div class='mt-6 grid gap-6 md:grid-cols-2'>
        {[1, 2].map(() => (
          <div class={`${card} border-dashed`} data-pending='testimonial'>
            <span class={pending}>Testimonial pending (#462)</span>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby='uses-heading' class='pb-14'>
      <p class={eyebrow}>Uses</p>
      <h2 id='uses-heading' class='mt-2 text-3xl font-bold text-strong'>The everyday stack</h2>
      <div class='mt-5 grid gap-6 md:grid-cols-3'>
        {uses.map((group) => (
          <div class={card}>
            <h3 class='font-semibold text-strong'>{group.title}</h3>
            <p class='mt-2 text-sm leading-relaxed text-soft'>{group.items}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby='facts-heading' class='pb-14'>
      <h2 id='facts-heading' class='text-2xl font-bold text-strong'>Quick facts</h2>
      <dl class='mt-4 grid gap-3 text-body sm:grid-cols-[max-content_1fr] sm:gap-x-6'>
        <dt class='font-semibold text-strong'>Location</dt>
        <dd>Atlanta, Georgia, USA</dd>
        <dt class='font-semibold text-strong'>Primary technologies</dt>
        <dd>Vue 3, TypeScript, JavaScript and Tailwind CSS</dd>
        <dt class='font-semibold text-strong'>Areas of expertise</dt>
        <dd>Front-end development, some back-end development and architecture, UI/UX implementation, open-source contribution, technical mentorship, and community building</dd>
        <dt class='font-semibold text-strong'>Services</dt>
        <dd>Software product development, technical consulting, code mentorship</dd>
        <dt class='font-semibold text-strong'>Current focus</dt>
        <dd>Front-end development with Vue 3, TypeScript, and Nuxt; mentoring junior developers, technical consulting, shipping customer-facing products, and contributing to open source</dd>
        <dt class='font-semibold text-strong'>Learning approach</dt>
        <dd>Learning in public: follow along on <a href='https://www.linkedin.com/in/nerando-johnson/recent-activity/all/' class='underline hover:no-underline' target='_blank' rel='noopener noreferrer'>LinkedIn</a> or read the <a href='/blog' class='underline hover:no-underline'>blog</a></dd>
        <dt class='font-semibold text-strong'>Beyond code</dt>
        <dd>Exploring new ideas, tinkering with technology, cooking, continuous learning, and building things that matter to real people</dd>
      </dl>
      <div class={`${card} mt-8`}>
        <h3 class='font-semibold text-strong'>Random fact about me</h3>
        <p class='mt-2 text-body'>{factOfTheDay}</p>
      </div>
      <p class='mt-6 text-body'>
        Find me on <a href='https://github.com/Nerajno' class='underline hover:no-underline' target='_blank' rel='noopener'>GitHub</a>,{' '}
        <a href='https://twitter.com/nerajno' class='underline hover:no-underline' target='_blank' rel='noopener'>Twitter</a>, and{' '}
        <a href='https://www.linkedin.com/in/nerando-johnson/' class='underline hover:no-underline' target='_blank' rel='noopener'>LinkedIn</a>.
      </p>
    </section>
  </Container>

  <section aria-labelledby='fastlane-heading' class='bg-surface-alt'>
    <Container>
      <div class='flex flex-wrap items-center justify-between gap-5 py-12'>
        <h2 id='fastlane-heading' class='text-2xl font-bold text-strong'>Want the two-minute version instead?</h2>
        <div class='flex flex-wrap items-center gap-4'>
          <span class={pending} data-pending='recruiters'>Recruiter fast lane pending (#457)</span>
          <a href='/contact' class='inline-flex min-h-11 items-center rounded-lg bg-accent px-6 font-semibold text-surface hover:bg-accent-hover'>Get in touch</a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
