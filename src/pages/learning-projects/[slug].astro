---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import projectsData, { getGrowthStatusConfig } from '../../data/projects';

export const prerender = true;

export async function getStaticPaths() {
  return projectsData.learning_projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const caseStudy = project?.case_study;
const notFound = !project || !caseStudy;
const growthStatus = project?.growth_status
  ? getGrowthStatusConfig(project.growth_status)
  : null;

// If not found, redirect to 404
if (notFound) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.title} - Learning Project`}>
  <Container>
    <main class='max-w-4xl mx-auto py-8'>
      <!-- Header -->
      <header class='mb-12'>
        <div class='flex items-center gap-4 mb-6'>
          <a
            href='/portfolio'
            class='text-blue-600 hover:text-blue-800 font-medium'
            >← Back to Portfolio</a
          >
        </div>
        <div class='flex items-center gap-4 mb-4'>
          <h1 class='text-4xl font-bold text-gray-900 dark:text-white'>
            {project.title}
          </h1>
          {
            growthStatus && (
              <span
                class={`inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium ${growthStatus.color}`}>
                <span class='text-lg'>{growthStatus.icon}</span>
                <span>{growthStatus.label}</span>
              </span>
            )
          }
        </div>
        <p class='text-xl text-gray-600 dark:text-gray-300 mb-6'>
          {project.description}
        </p>
        <div class='flex gap-4'>
          {
            project.demo && (
              <a
                href={project.demo}
                target='_blank'
                rel='noopener noreferrer'
                class='bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors'>
                View Live Demo
              </a>
            )
          }
          {
            project.github && (
              <a
                href={project.github}
                target='_blank'
                rel='noopener noreferrer'
                class='border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors'>
                View Source Code
              </a>
            )
          }
          <a
            href={`/learning-plot/${project.id}`}
            class='bg-green-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-700 transition-colors'
            >Learning Plot</a
          >
        </div>
      </header>

      <!-- Project Images -->
      {
        caseStudy.images && caseStudy.images.length > 0 && (
          <section class='mb-12'>
            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
              {caseStudy.images.map((image, index) =>
                image.endsWith('.mp4') ||
                (image.startsWith('http') && image.includes('youtu')) ? (
                  <video
                    src={image}
                    controls
                    class='rounded-lg shadow-lg w-full h-auto'
                  />
                ) : (
                  <img
                    src={image || '/placeholder.svg'}
                    alt={`${project.title} screenshot ${index + 1}`}
                    class='rounded-lg shadow-lg w-full h-auto'
                  />
                )
              )}
            </div>
          </section>
        )
      }

      <!-- Project Overview -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Project Overview
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <p class='text-gray-700 dark:text-gray-300 mb-6 leading-relaxed'>
            {caseStudy.overview}
          </p>
          <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
            <div>
              <h3
                class='text-lg font-semibold text-gray-900 dark:text-white mb-3'>
                Problem Statement
              </h3>
              <p class='text-gray-700 dark:text-gray-300 leading-relaxed'>
                {caseStudy.problem}
              </p>
            </div>
            <div>
              <h3
                class='text-lg font-semibold text-gray-900 dark:text-white mb-3'>
                Target Audience
              </h3>
              <p class='text-gray-700 dark:text-gray-300 leading-relaxed'>
                {caseStudy.audience}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Features -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Key Features
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <ul class='grid grid-cols-1 md:grid-cols-2 gap-4'>
            {
              caseStudy.features &&
                caseStudy.features.map((feature) => (
                  <li class='flex items-start gap-3'>
                    <svg
                      class='w-5 h-5 text-green-500 mt-0.5 flex-shrink-0'
                      fill='currentColor'
                      viewBox='0 0 20 20'>
                      <path
                        fill-rule='evenodd'
                        d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
                        clip-rule='evenodd'
                      />
                    </svg>
                    <span class='text-gray-700 dark:text-gray-300'>
                      {feature}
                    </span>
                  </li>
                ))
            }
          </ul>
        </div>
      </section>

      <!-- Technical Stack -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Technical Stack
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <div class='flex flex-wrap gap-2'>
            {
              Array.isArray(caseStudy.tech_stack)
                ? caseStudy.tech_stack.map((tech) => (
                    <span class='bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-3 py-1 rounded-full text-sm font-medium'>
                      {tech}
                    </span>
                  ))
                : Object.entries(caseStudy.tech_stack).map(
                    ([section, stack]) => (
                      <div key={section}>
                        <span class='font-semibold mr-2'>{section}:</span>
                        {stack.map((tech) => (
                          <span
                            key={tech}
                            class='bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-3 py-1 rounded-full text-sm font-medium mr-2'>
                            {tech}
                          </span>
                        ))}
                      </div>
                    )
                  )
            }
          </div>
        </div>
      </section>

      <!-- Timeline, Key Changes, Learnings -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Timeline & Learnings
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <div class='mb-4'>
            <span class='font-semibold'>Timeline:</span>
            {caseStudy.timeline}
          </div>
          <div class='mb-4'>
            <span class='font-semibold'>Key Changes:</span>
            <ul class='list-disc list-inside ml-4'>
              {
                caseStudy.key_changes &&
                  caseStudy.key_changes.map((change, index) => (
                    <li key={index}>{change}</li>
                  ))
              }
            </ul>
          </div>
          <div class='mb-4'>
            <span class='font-semibold'>Stuff I Learnt:</span>
            <ul class='list-disc list-inside ml-4'>
              {
                caseStudy.learnings &&
                  caseStudy.learnings.map((learn, index) => (
                    <li key={index}>{learn}</li>
                  ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Results & Feedback -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Results & Feedback
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <div class='mb-4'>
            <span class='font-semibold'>Results & Impact:</span>
            {caseStudy.results}
          </div>
          <div class='mb-4'>
            <span class='font-semibold'>Tester Feedback:</span>
            <ul class='list-disc list-inside ml-4'>
              {
                caseStudy.feedback &&
                  caseStudy.feedback.map((fb, index) => (
                    <li key={index}>
                      "{fb.quote}" — {fb.author}
                    </li>
                  ))
              }
            </ul>
          </div>
          <div>
            <span class='font-semibold'>Future Improvements:</span>
            <ul class='list-disc list-inside ml-4'>
              {
                caseStudy.improvements &&
                  caseStudy.improvements.map((imp, index) => (
                    <li key={index}>{imp}</li>
                  ))
              }
            </ul>
          </div>
        </div>
      </section>
    </main>
  </Container>
</Layout>
