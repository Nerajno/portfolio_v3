---
import { getCollection, render } from 'astro:content';
import { SEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';

export const prerender = true;

export async function getStaticPaths() {
  // Helpers live here: getStaticPaths runs in isolation from the rest of the frontmatter
  const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, '-');
  const isPublished = (data: { draft?: boolean; publishDate?: Date }) =>
    !data.draft && !!data.publishDate && data.publishDate < new Date();

  // All parts, drafts included: unpublished parts are listed (not linked) on the page (#469)
  const seriesPosts = await getCollection('blog', ({ data }) => !!data.series);

  const seriesMap = new Map<string, typeof seriesPosts>();
  for (const post of seriesPosts) {
    const name = post.data.series!.name;
    if (!seriesMap.has(name)) seriesMap.set(name, []);
    seriesMap.get(name)!.push(post);
  }

  // A series gets a page once at least one part is published
  return Array.from(seriesMap.entries())
    .filter(([, posts]) => posts.some((p) => isPublished(p.data)))
    .map(([seriesName, posts]) => ({
      params: { seriesName: slugify(seriesName) },
      props: {
        seriesName,
        seriesSlug: slugify(seriesName),
        posts: posts
          .sort((a, b) => a.data.series!.order - b.data.series!.order)
          .map((post) => ({ post, published: isPublished(post.data) }))
          // A draft that shares its slot with a published part is a stale copy: skip it
          .filter((e, _, all) =>
            e.published || !all.some((o) => o.published && o.post.data.series!.order === e.post.data.series!.order)
          ),
      },
    }));
}

const { seriesName, seriesSlug, posts: entries } = Astro.props;
const posts = entries.map((e) => e.post);

const parts = await Promise.all(
  entries.map(async ({ post, published }) => {
    let minutesRead = '';
    if (published) {
      const { remarkPluginFrontmatter } = await render(post);
      minutesRead = remarkPluginFrontmatter?.minutesRead || '1 min read';
    }
    return {
      title: post.data.title,
      snippet: post.data.snippet,
      order: post.data.series!.order,
      href: `/blog/${post.id.replace(/\.(md|mdx)$/, '')}`,
      published,
      minutesRead,
    };
  })
);

const publishedCount = parts.filter((p) => p.published).length;
const total = parts.length;
const percent = Math.round((publishedCount / total) * 100);
const companion = posts.find((p) => p.data.series?.companion)?.data.series?.companion;
const talk = posts.find((p) => p.data.series?.talk)?.data.series?.talk;
const firstImage = entries.find((e) => e.published && e.post.data.image)?.post.data.image;

const seoConfig = {
  title: `${seriesName} - Blog Series | My MetaData`,
  description: `The ${seriesName} series: ${total} parts, ${publishedCount} published so far. Read it in order or jump to a part.`,
  canonical: new URL(`series/${seriesSlug}`, Astro.site).toString(),
};
---

<Layout title={`${seriesName} Series`} surface='teach'>
  <SEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    openGraph={{
      basic: {
        title: seoConfig.title,
        type: 'website',
        image: firstImage?.src || '/og-blog.jpg',
        url: seoConfig.canonical,
      },
      optional: {
        description: seoConfig.description,
        siteName: 'My MetaData',
      },
    }}
    twitter={{
      creator: '@nerajno',
      site: '@nerajno',
      card: 'summary_large_image',
    }}
  />

  <Container>
    <nav aria-label='Breadcrumb' class='mx-auto max-w-3xl pt-8 text-sm text-soft'>
      <a href='/blog' class='text-soft hover:text-accent'>Writing</a>
      <span aria-hidden='true'> / </span>Series<span aria-hidden='true'> / </span>
      <span aria-current='page'>{seriesName}</span>
    </nav>

    <header class='mx-auto max-w-3xl pt-10'>
      <p class='text-sm font-medium uppercase tracking-wider text-accent'>Series · {total} parts</p>
      <h1 class='mt-2 font-heading text-4xl md:text-5xl font-bold tracking-tight text-strong'>{seriesName}</h1>
      <p class='mt-3 text-lg leading-relaxed text-soft'>
        Read it in order or jump to a part. Parts still in progress are listed so you can see where it's headed.
      </p>
      <div class='mt-5 flex items-center gap-4' id='series-progress'>
        <div class='h-2 max-w-xs flex-1 rounded bg-surface-alt' aria-hidden='true'>
          <div class='h-2 rounded bg-accent' style={`width: ${percent}%`}></div>
        </div>
        <span class='font-mono text-sm text-soft'>{publishedCount} of {total} published</span>
      </div>
    </header>

    <ol class='mx-auto mt-8 max-w-3xl list-none p-0 pb-14' id='series-parts' aria-label={`${seriesName} parts`}>
      {
        parts.map((part) => {
          const num = String(part.order).padStart(2, '0');
          const body = (
            <>
              <span class={`w-8 flex-shrink-0 font-mono text-sm ${part.published ? 'text-accent' : 'text-soft'}`}>{num}</span>
              <span class='min-w-0 flex-1'>
                <span class={`block font-heading text-xl font-semibold ${part.published ? 'text-strong group-hover:text-accent' : 'text-soft'}`}>
                  {part.title}
                </span>
                <span class='mt-1 block text-sm text-soft line-clamp-2'>
                  {part.published ? `${part.snippet ? part.snippet + ' · ' : ''}${part.minutesRead}` : 'In progress'}
                </span>
              </span>
              <span class={`flex-shrink-0 font-mono text-xs uppercase ${part.published ? 'text-accent' : 'text-muted'}`}>
                {part.published ? 'Published' : 'Drafting'}
              </span>
            </>
          );
          return (
            <li class='border-t border-surface last:border-b' data-status={part.published ? 'published' : 'drafting'}>
              {part.published ? (
                <a href={part.href} class='group flex items-baseline gap-4 px-2 py-4 no-underline'>{body}</a>
              ) : (
                <div class='flex items-baseline gap-4 px-2 py-4'>{body}</div>
              )}
            </li>
          );
        })
      }
      {
        companion && (
          <li class='border-t border-surface last:border-b' data-status='companion'>
            <div class='flex items-baseline gap-4 px-2 py-4'>
              <span class='w-8 flex-shrink-0 font-mono text-sm text-soft' aria-hidden='true'>★</span>
              <span class='min-w-0 flex-1'>
                <span class='block font-heading text-xl font-semibold text-strong'>{companion.title}</span>
                {companion.note && <span class='mt-1 block text-sm text-soft'>{companion.note}</span>}
              </span>
              <a href={companion.href} class='flex-shrink-0 font-mono text-xs uppercase'>Artifact →</a>
            </div>
          </li>
        )
      }
    </ol>
  </Container>

  {
    talk && (
      <section class='bg-surface-alt' aria-label='Talk version'>
        <Container>
          <div class='mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 py-9'>
            <span class='text-body'>{talk.text}</span>
            <a href={talk.href} class='font-semibold'>See the talk version →</a>
          </div>
        </Container>
      </section>
    )
  }
</Layout>
