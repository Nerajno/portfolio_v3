---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import type { CollectionEntry } from 'astro:content';
import { Tweet } from 'astro-embed';

export const prerender = true;

interface Props {
  entry: CollectionEntry<'blog'>;
}

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;

// Add error handling for entry rendering
let Content;
let remarkPluginFrontmatter;

try {
  const rendered = await entry.render();
  Content = rendered.Content;
  remarkPluginFrontmatter = rendered.remarkPluginFrontmatter;
} catch (error) {
  console.error('Error rendering entry:', error);
  return new Response('Error rendering blog post', { status: 500 });
}
---

<Layout title={entry.data.title}>
  <Container>
    <div class='mx-auto max-w-3xl mt-14'>
      {
        entry.data.image && (
          <Image
            src={entry.data.image.src}
            alt={entry.data.image.alt}
            width={800}
            height={600}
            class='w-full object-cover rounded-lg mb-6'
          />
        )
      }

      <span class='text-blue-400 uppercase tracking-wider text-sm font-medium'>
        {entry.data.category}
      </span>
      <h1
        class='text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight'>
        {entry.data.title}
      </h1>
      <div class='flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap'>
        <span class='text-slate-500 dark:text-slate-400'>
          {entry.data.author}
        </span>
        <span class='text-slate-500 dark:text-slate-400'>•</span>
        <time
          class='text-slate-500 dark:text-slate-400'
          datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toDateString()}
        </time>
        <span class='text-slate-500 dark:text-slate-400 hidden md:block'>•</span
        >
        <div class='w-full md:w-auto flex flex-wrap gap-3'>
          {
            entry.data.tags.map((tag) => (
              <span class='text-sm text-slate-500 dark:text-slate-400'>
                #{tag}
              </span>
            ))
          }
        </div>
      </div>
      <br />
      {
        remarkPluginFrontmatter?.minutesRead && (
          <p class='text-slate-500 dark:text-slate-400'>
            {remarkPluginFrontmatter.minutesRead}
          </p>
        )
      }
    </div>

    <div
      class='mx-auto prose prose-lg mt-6 max-w-3xl text-slate-500 dark:text-slate-400 prose-headings:text-slate-500 prose-headings:dark:text-slate-400 prose-p:text-slate-500 prose-p:dark:text-slate-400 prose-strong:text-slate-500 prose-strong:dark:text-slate-400 prose-em:text-slate-500 prose-em:dark:text-slate-400 prose-a:text-blue-600 prose-a:dark:text-blue-400 prose-code:text-slate-500 prose-code:dark:text-slate-400 prose-img:mx-auto'>
      {Content && <Content />}
      <!-- For embedding tweets -->
      {entry.data.tweetIds?.map((id) => <Tweet id={id} />)}
    </div>
    <div class='text-center mt-8'>
      <a
        href='/blog'
        class='text-slate-500 dark:text-slate-300 hover:font-bold hover:font-bold dark:bg-gray-600 px-5 py-3 rounded-md dark:hover:bg-gray-700 transition border border-slate-500 dark:border-slate-300'
        >← Back to Blogs</a
      >
    </div>
  </Container>
</Layout>
