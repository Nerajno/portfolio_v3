---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SEO } from 'astro-seo-plugin';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import type { CollectionEntry } from 'astro:content';
import { Tweet } from 'astro-embed';
import ViewCounter from '@components/viewcounter.astro';

export const prerender = true;
export const revalidate = 60; // Revalidate every 60 seconds


interface Props {
  entry: CollectionEntry<'blog'>;
}

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;

// Add error handling for entry rendering
let Content;
let remarkPluginFrontmatter: { minutesRead?: string } | undefined;

try {
  const rendered = await entry.render();
  Content = rendered.Content;
  remarkPluginFrontmatter = rendered.remarkPluginFrontmatter;
} catch (error) {
  console.error('Error rendering entry:', error);
  return new Response('Error rendering blog post', { status: 500 });
}

// SEO configuration for the blog post
const postUrl = new URL(`blog/${entry.slug}`, Astro.site).toString();
const seoTitle = entry.data.seoTitle || `${entry.data.title} | My MetaData`;
const seoDescription =
  entry.data.seoDescription || entry.data.description || entry.data.snippet;
const ogImage = entry.data.ogImage?.src || entry.data.image.src;
const ogImageAlt = entry.data.ogImage?.alt || entry.data.image.alt;
const keywords = entry.data.keywords || entry.data.tags;

const seoConfig = {
  title: seoTitle,
  description: seoDescription,
  canonical: entry.data.canonical || postUrl,
  noindex: entry.data.noindex,
  nofollow: entry.data.noindex, // Usually pair noindex with nofollow
  openGraph: {
    basic: {
      title: seoTitle,
      type: 'article',
      image: new URL(ogImage, Astro.site).toString(),
      url: postUrl,
    },
    optional: {
      description: seoDescription,
      siteName: 'My MetaData',
    },
    image: {
      alt: ogImageAlt,
      width: 1200,
      height: 630,
    },
    article: {
      publishedTime: entry.data.publishDate.toISOString(),
      modifiedTime:
        entry.data.updatedDate?.toISOString() ||
        entry.data.publishDate.toISOString(),
      author: [entry.data.author],
      section: entry.data.category,
      tag: entry.data.tags,
    },
  },
  twitter: {
    creator: entry.data.author,
    site: '@nerajno',
    card: 'summary_large_image',
    title: seoTitle,
    description: seoDescription,
    image: new URL(ogImage, Astro.site).toString(),
    imageAlt: ogImageAlt,
  },
};
---

<Layout title={entry.data.title}>
  <SEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    noindex={seoConfig.noindex}
    nofollow={seoConfig.nofollow}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={{
      meta: [
        { name: 'author', content: entry.data.author },
        { name: 'keywords', content: keywords?.join(', ') || '' },
        { property: 'article:author', content: entry.data.author },
        { property: 'article:section', content: entry.data.category },
        {
          property: 'article:published_time',
          content: entry.data.publishDate.toISOString(),
        },
        {
          property: 'article:modified_time',
          content:
            entry.data.updatedDate?.toISOString() ||
            entry.data.publishDate.toISOString(),
        },
        // Additional meta tags
        { property: 'og:locale', content: 'en_US' },
        { name: 'theme-color', content: '#1e293b' },
        { name: 'geo.region', content: 'US-GA' },
        { name: 'geo.placename', content: 'Atlanta' },
        { property: 'profile:first_name', content: 'Nerando' },
        { property: 'profile:last_name', content: 'Johnson' },
        // Reading time meta tag
        ...(remarkPluginFrontmatter?.minutesRead
          ? [
              { name: 'twitter:label1', content: 'Reading time' },
              {
                name: 'twitter:data1',
                content: remarkPluginFrontmatter.minutesRead,
              },
            ]
          : []),
      ],
      link: [
        // Prev/Next navigation for blog posts could be added here
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'My MetaData Blog RSS',
          href: '/rss.xml',
        },
      ],
    }}
  />

  <!-- JSON-LD Structured Data for Blog Post -->
  <script
    type='application/ld+json'
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: entry.data.title,
      description: seoDescription,
      image: {
        '@type': 'ImageObject',
        url: new URL(ogImage, Astro.site).toString(),
        alt: ogImageAlt,
        width: 1200,
        height: 630,
      },
      author: {
        '@type': 'Person',
        name: entry.data.author,
        url: `${Astro.site}about`,
        jobTitle: 'Software Developer',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Atlanta',
          addressRegion: 'GA',
          addressCountry: 'US',
        },
        sameAs: [
          'https://github.com/Nerajno',
          'https://twitter.com/nerajno',
          'https://www.linkedin.com/in/nerando-johnson/',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'My MetaData',
        url: Astro.site?.toString(),
        logo: {
          '@type': 'ImageObject',
          url: `${Astro.site}logo.png`, // Add your logo
          width: 400,
          height: 400,
        },
      },
      datePublished: entry.data.publishDate.toISOString(),
      dateModified:
        entry.data.updatedDate?.toISOString() ||
        entry.data.publishDate.toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': postUrl,
      },
      url: postUrl,
      keywords: keywords?.join(', ') || (entry.data.tags ?? []).join(', '),
      articleSection: entry.data.category,
      wordCount: remarkPluginFrontmatter?.words || undefined,
      timeRequired: remarkPluginFrontmatter?.minutesRead || undefined,
      inLanguage: 'en-US',
      copyrightYear: entry.data.publishDate.getFullYear(),
      copyrightHolder: {
        '@type': 'Person',
        name: entry.data.author,
        sameAs: `${Astro.site}about`, // Add your about page URL for the author
      },
    })}
  />

<Container>
  <article class="mx-auto max-w-[80vw] mt-14 px-2">
    {/* Hero image with better treatment */}
    {entry.data.image && (
      <div class="mb-12 -mx-6 md:mx-0">
        <Image
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          width={1200}
          height={675}
          class="w-full object-cover rounded-none md:rounded-2xl shadow-2xl"
        />
      </div>
    )}

    {/* Category */}
    <span class="text-blue-400 uppercase tracking-wider text-xs font-semibold">
      {entry.data.category}
    </span>

    {/* Title */}
    <h1 class="text-5xl md:text-6xl font-bold mt-4 mb-6 leading-[1.1] tracking-tight text-slate-900 dark:text-slate-50">
      {entry.data.title}
    </h1>

    {/* Meta info */}
    <div class="flex gap-3 mb-12 items-center flex-wrap text-base text-slate-600 dark:text-slate-400">
      <span>{entry.data.author}</span>
      <span>•</span>
      <time datetime={entry.data.publishDate.toISOString()}>
        {entry.data.publishDate.toDateString()}
      </time>
      {remarkPluginFrontmatter?.minutesRead && (
        <>
          <span>•</span>
          <span>{remarkPluginFrontmatter.minutesRead}</span>
        </>
      )}
      <span>•</span>
      <ViewCounter slug={entry.slug} />
    </div>

    {/* Content */}
    <div class="prose-custom">
      {Content && <Content />}
    </div>

    {/* Enhanced footer */}
    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row gap-4 justify-between items-center">

          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-blue-500 hover:text-blue-500 dark:hover:border-blue-400 dark:hover:text-blue-400 transition-all group font-medium">
          <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Blog
        </a>

        {/* Social share buttons */}
        <div class="flex gap-3">

            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(postUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white dark:hover:bg-blue-500 transition-colors"
            aria-label="Share on Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</Container>

<style>
  /* Same prose-custom styles as BlogLayout.astro */
</style>
</Layout>
