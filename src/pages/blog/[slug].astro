---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { SEO } from 'astro-seo';
import Layout from '@layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import { Tweet } from 'astro-embed';
import ViewCounter from '@components/viewcounter.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import SeriesNavigation from '@components/SeriesNavigation.astro';
import MarkContentAsSeen from '@components/MarkContentAsSeen.astro';
import {
  SocialShare,
  TwitterShareButton,
  LinkedInShareButton,
  WhatsAppShareButton,
  BlueskyShareButton
} from 'astro-social-share';
import { buildArticleSchema, buildSpeakableSchema, buildFAQSchema, sanitizeSchema } from '@lib/schema';


export const prerender = true;
export const revalidate = 60; // Revalidate every 60 seconds


interface Props {
  entry: CollectionEntry<'blog'>;
}

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return !data.draft && data.publishDate < new Date();
  });
  return blogEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const entrySlug = entry.id.replace(/\.(md|mdx)$/, '');

// Add error handling for entry rendering
let Content;
let remarkPluginFrontmatter: { minutesRead?: string } | undefined;

try {
  const rendered = await render(entry);
  Content = rendered.Content;
  remarkPluginFrontmatter = rendered.remarkPluginFrontmatter;
} catch (error) {
  console.error('Error rendering entry:', error);
  return new Response('Error rendering blog post', { status: 500 });
}

// SEO configuration for the blog post
const postUrl = new URL(`blog/${entrySlug}`, Astro.site).toString();
const seoTitle = entry.data.seoTitle || `${entry.data.title} | My MetaData`;
const seoDescription =
  entry.data.seoDescription || entry.data.description || entry.data.snippet;
const ogImage = entry.data.ogImage?.src || entry.data.image.src;
const ogImageAlt = entry.data.ogImage?.alt || entry.data.image.alt;
const keywords = entry.data.keywords || entry.data.tags;

// Use the canonical post URL directly for social sharing to avoid
// external network calls during prerender/ISR.
const shortUrl = postUrl;

// Compute series navigation once — passed as props to both SeriesNavigation instances
let seriesNavProps: {
  seriesName: string;
  currentPart: number;
  totalParts: number;
  previousPost: typeof entry | null;
  nextPost: typeof entry | null;
} | null = null;

if (entry.data.series) {
  const seriesName = entry.data.series.name;
  const allSeriesPosts = (await getCollection('blog', ({ data }) =>
    !data.draft &&
    data.publishDate < new Date() &&
    data.series?.name === seriesName
  )).sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));

  const currentIndex = allSeriesPosts.findIndex((p) => p.id.replace(/\.(md|mdx)$/, '') === entrySlug);

  if (currentIndex !== -1) {
    seriesNavProps = {
      seriesName,
      currentPart: entry.data.series.order,
      totalParts: allSeriesPosts.length,
      previousPost: currentIndex > 0 ? allSeriesPosts[currentIndex - 1] : null,
      nextPost:
        currentIndex < allSeriesPosts.length - 1
          ? allSeriesPosts[currentIndex + 1]
          : null,
    };
  }
}

// #342: chronological previous/next across all published posts
const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft && data.publishDate < new Date()))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const postIndex = publishedPosts.findIndex((p) => p.id === entry.id);
const newerPost = postIndex > 0 ? publishedPosts[postIndex - 1] : null;
const olderPost = postIndex >= 0 && postIndex < publishedPosts.length - 1 ? publishedPosts[postIndex + 1] : null;
const slugOf = (p) => p.id.replace(/\.(md|mdx)$/, '');
const eyebrow = entry.data.series
  ? `Series · ${entry.data.series.name} · Part ${entry.data.series.order}`
  : entry.data.category;
const longDate = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const seoConfig = {
  title: seoTitle,
  description: seoDescription,
  canonical: entry.data.canonical || postUrl,
  noindex: entry.data.noindex,
  nofollow: entry.data.noindex, // Usually pair noindex with nofollow
  openGraph: {
    basic: {
      title: seoTitle,
      type: 'article',
      image: new URL(ogImage, Astro.site).toString(),
      url: postUrl,
    },
    optional: {
      description: seoDescription,
      siteName: 'My MetaData',
    },
    image: {
      alt: ogImageAlt,
      width: 1200,
      height: 630,
    },
    article: {
      publishedTime: entry.data.publishDate.toISOString(),
      modifiedTime:
        entry.data.updatedDate?.toISOString() ||
        entry.data.publishDate.toISOString(),
      author: [entry.data.author],
      section: entry.data.category,
      tag: entry.data.tags,
    },
  },
  twitter: {
    creator: entry.data.author,
    site: '@nerajno',
    card: 'summary_large_image',
    title: seoTitle,
    description: seoDescription,
    image: new URL(ogImage, Astro.site).toString(),
    imageAlt: ogImageAlt,
  },
};
---

<Layout title={entry.data.title} description={seoDescription} surface='teach' customSeo>
  <ReadingProgressBar />
  <MarkContentAsSeen />
  <SEO
    slot='head'
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    noindex={seoConfig.noindex}
    nofollow={seoConfig.nofollow}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={{
      meta: [
        { name: 'author', content: entry.data.author },
        { name: 'keywords', content: keywords?.join(', ') || '' },
        { property: 'article:author', content: entry.data.author },
        { property: 'article:section', content: entry.data.category },
        {
          property: 'article:published_time',
          content: entry.data.publishDate.toISOString(),
        },
        {
          property: 'article:modified_time',
          content:
            entry.data.updatedDate?.toISOString() ||
            entry.data.publishDate.toISOString(),
        },
        // Additional meta tags
        { property: 'og:locale', content: 'en_US' },
        { name: 'theme-color', content: '#1e293b' },
        { name: 'geo.region', content: 'US-GA' },
        { name: 'geo.placename', content: 'Atlanta' },
        { property: 'profile:first_name', content: 'Nerando' },
        { property: 'profile:last_name', content: 'Johnson' },
        // Reading time meta tag
        ...(remarkPluginFrontmatter?.minutesRead
          ? [
              { name: 'twitter:label1', content: 'Reading time' },
              {
                name: 'twitter:data1',
                content: remarkPluginFrontmatter.minutesRead,
              },
            ]
          : []),
      ],
      link: [
        // Prev/Next navigation for blog posts could be added here
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'My MetaData Blog RSS',
          href: '/rss.xml',
        },
      ],
    }}
  />

  <!-- AEO: TechArticle schema -->
  <script
    slot='head'
    type='application/ld+json'
    set:html={sanitizeSchema(buildArticleSchema({
      title: entry.data.title,
      description: seoDescription ?? '',
      url: postUrl,
      image: new URL(ogImage, Astro.site).toString(),
      publishDate: entry.data.publishDate,
      updatedDate: entry.data.updatedDate,
      keywords: keywords,
    }))}
  />

  <!-- AEO: SpeakableSpecification -->
  <script slot='head' type='application/ld+json' set:html={sanitizeSchema(buildSpeakableSchema(postUrl))} />

  <!-- AEO: FAQPage (if frontmatter faqs present) -->
  {entry.data.faqs && entry.data.faqs.length > 0 && (
    <script slot='head' type='application/ld+json' set:html={sanitizeSchema(buildFAQSchema(entry.data.faqs))} />
  )}

  <article class='mx-auto max-w-[56rem] px-5 pb-16 pt-12'>
    <nav aria-label='Breadcrumb' class='text-sm text-soft'>
      <a href='/blog' class='underline hover:text-accent'>Writing</a> / <span aria-current='page'>{entry.data.title}</span>
    </nav>

    <header class='mt-8'>
      <p class='text-sm font-medium uppercase tracking-wider text-accent'>{eyebrow}</p>
      <h1 class='mt-2 font-heading text-4xl md:text-5xl font-bold leading-tight tracking-tight text-strong'>
        {entry.data.title}
      </h1>
      <p class='mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-soft'>
        <time datetime={entry.data.publishDate.toISOString()}>{longDate(entry.data.publishDate)}</time>
        {entry.data.updatedDate && <><span aria-hidden='true'>•</span><span>Updated {longDate(entry.data.updatedDate)}</span></>}
        {remarkPluginFrontmatter?.minutesRead && <><span aria-hidden='true'>•</span><span>{remarkPluginFrontmatter.minutesRead}</span></>}
        <span aria-hidden='true'>•</span>
        <ViewCounter slug={entrySlug} increment={true} />
      </p>
    </header>

    {
      entry.data.audio && (
        <figure class='mt-6 rounded-lg border border-surface bg-surface-card p-4'>
          <figcaption class='mb-2 font-mono text-xs uppercase text-soft'>
            Listen{entry.data.audio.duration && <> · {entry.data.audio.duration}</>}
          </figcaption>
          <audio controls preload='none' src={entry.data.audio.src} class='w-full'>
            <a href={entry.data.audio.src}>Download the narration</a>
          </audio>
        </figure>
      )
    }

    {
      entry.data.image && (
        <Image
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          width={1200}
          height={630}
          loading='eager'
          fetchpriority='high'
          class='mt-8 w-full rounded-xl object-cover'
        />
      )
    }

    {seriesNavProps && <SeriesNavigation {...seriesNavProps} />}

    <div class='post-prose prose prose-lg mt-8 max-w-none'>
      {Content && <Content />}
      {entry.data.tweetIds?.map((id) => <Tweet id={`https://twitter.com/i/web/status/${id}`} />)}
    </div>

    {seriesNavProps && <SeriesNavigation {...seriesNavProps} />}

    <footer class='mt-12 flex flex-col gap-6 border-t border-surface pt-8'>
      {
        entry.data.tags?.length > 0 && (
          <ul class='flex flex-wrap gap-2' aria-label='Tags'>
            {entry.data.tags.map((tag) => (
              <li class='rounded border border-surface bg-surface-alt px-2.5 py-1 font-mono text-xs text-body'>{tag}</li>
            ))}
          </ul>
        )
      }

      <section aria-label='About the author' class='flex flex-wrap items-center gap-4 rounded-xl border border-surface bg-surface-card px-6 py-5'>
        <div class='min-w-0 flex-[999_1_18rem]'>
          <p class='font-semibold text-strong'>Nerando Johnson</p>
          <p class='mt-0.5 text-sm leading-relaxed text-soft'>
            Software engineer (Vue 3/TypeScript), former teacher, Atlanta.
            {
              entry.data.relatedArtifact && (
                <>
                  {' '}This post pairs with{' '}
                  <a href={entry.data.relatedArtifact.href} class='font-medium text-accent underline'>{entry.data.relatedArtifact.label}</a>.
                </>
              )
            }
          </p>
        </div>
      </section>

      <nav aria-label='More posts' class='flex flex-wrap justify-between gap-3 text-sm font-medium'>
        {olderPost ? (
          <a href={`/blog/${slugOf(olderPost)}`} class='inline-flex min-h-11 max-w-full items-center text-accent hover:underline' rel='prev'>
            ← {olderPost.data.title}
          </a>
        ) : <span />}
        {newerPost && (
          <a href={`/blog/${slugOf(newerPost)}`} class='inline-flex min-h-11 max-w-full items-center text-right text-accent hover:underline' rel='next'>
            {newerPost.data.title} →
          </a>
        )}
      </nav>

      <div class='flex flex-wrap items-center justify-between gap-4'>
        <a href='/blog' class='inline-flex min-h-11 items-center rounded-lg border border-surface-strong px-5 font-medium text-body hover:bg-surface-alt'>
          ← Back to blog
        </a>
        <div class='social-share-wrapper text-soft'>
          <SocialShare
            description={seoDescription}
            title={entry.data.title}
            url={shortUrl}
            via='nerajno'
            buttons={[TwitterShareButton, LinkedInShareButton, BlueskyShareButton, WhatsAppShareButton]}
          />
        </div>
      </div>
    </footer>
  </article>
</Layout>

<style is:global>
  .social-share-wrapper svg {
    height: 32px;
    width: 32px;
    color: currentColor;
    fill: currentColor;
    transition: transform 0.2s ease;
  }

  .social-share-wrapper svg:hover {
    color: var(--accent);
    fill: var(--accent);
    transform: scale(1.25);
  }

  .social-share-wrapper a {
    margin-right: 16px;
  }

  /* #342 teach prose: 18px / 1.78, Dialects tokens via the typography plugin's variables */
  .post-prose {
    font-size: 1.125rem;
    line-height: 1.78;
    --tw-prose-body: var(--text-body);
    --tw-prose-headings: var(--text-strong);
    --tw-prose-lead: var(--text-soft);
    --tw-prose-links: var(--accent);
    --tw-prose-bold: var(--text-strong);
    --tw-prose-counters: var(--text-soft);
    --tw-prose-bullets: var(--text-muted);
    --tw-prose-hr: var(--border);
    --tw-prose-quotes: var(--text-soft);
    --tw-prose-quote-borders: var(--accent);
    --tw-prose-captions: var(--text-soft);
    --tw-prose-code: var(--text-strong);
    --tw-prose-th-borders: var(--border-strong);
    --tw-prose-td-borders: var(--border);
  }
  .post-prose :where(h2, h3, h4) { font-family: var(--font-heading); }
  .post-prose :where(h2) { line-height: 1.33; }
  .post-prose :where(blockquote) { font-style: italic; border-left-width: 3px; }
  .post-prose :where(:not(pre) > code) {
    background: var(--bg-alt);
    border-radius: 4px;
    padding: 0.125rem 0.5rem;
    font-weight: 500;
  }
  .post-prose :where(:not(pre) > code)::before,
  .post-prose :where(:not(pre) > code)::after { content: none; }
</style>
