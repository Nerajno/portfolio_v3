---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SEO } from 'astro-seo-plugin';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import type { CollectionEntry } from 'astro:content';
import { Tweet } from 'astro-embed';
import ViewCounter from '@components/viewcounter.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import SeriesNavigation from '@components/SeriesNavigation.astro';
import MarkContentAsSeen from '@components/MarkContentAsSeen.astro';
import {
  SocialShare,
  TwitterShareButton,
  LinkedInShareButton,
  WhatsAppShareButton,
  BlueskyShareButton
} from 'astro-social-share';


export const prerender = true;
export const revalidate = 60; // Revalidate every 60 seconds


interface Props {
  entry: CollectionEntry<'blog'>;
}

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;

// Add error handling for entry rendering
let Content;
let remarkPluginFrontmatter: { minutesRead?: string } | undefined;

try {
  const rendered = await entry.render();
  Content = rendered.Content;
  remarkPluginFrontmatter = rendered.remarkPluginFrontmatter;
} catch (error) {
  console.error('Error rendering entry:', error);
  return new Response('Error rendering blog post', { status: 500 });
}

// SEO configuration for the blog post
const postUrl = new URL(`blog/${entry.slug}`, Astro.site).toString();
const seoTitle = entry.data.seoTitle || `${entry.data.title} | My MetaData`;
const seoDescription =
  entry.data.seoDescription || entry.data.description || entry.data.snippet;
const ogImage = entry.data.ogImage?.src || entry.data.image.src;
const ogImageAlt = entry.data.ogImage?.alt || entry.data.image.alt;
const keywords = entry.data.keywords || entry.data.tags;

// Use the canonical post URL directly for social sharing to avoid
// external network calls during prerender/ISR.
const shortUrl = postUrl;

// Compute series navigation once — passed as props to both SeriesNavigation instances
let seriesNavProps: {
  seriesName: string;
  currentPart: number;
  totalParts: number;
  previousPost: typeof entry | null;
  nextPost: typeof entry | null;
} | null = null;

if (entry.data.series) {
  const seriesName = entry.data.series.name;
  const allSeriesPosts = (await getCollection('blog', ({ data }) =>
    !data.draft &&
    data.publishDate < new Date() &&
    data.series?.name === seriesName
  )).sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));

  const currentIndex = allSeriesPosts.findIndex((p) => p.slug === entry.slug);

  if (currentIndex !== -1) {
    seriesNavProps = {
      seriesName,
      currentPart: entry.data.series.order,
      totalParts: allSeriesPosts.length,
      previousPost: currentIndex > 0 ? allSeriesPosts[currentIndex - 1] : null,
      nextPost:
        currentIndex < allSeriesPosts.length - 1
          ? allSeriesPosts[currentIndex + 1]
          : null,
    };
  }
}

const seoConfig = {
  title: seoTitle,
  description: seoDescription,
  canonical: entry.data.canonical || postUrl,
  noindex: entry.data.noindex,
  nofollow: entry.data.noindex, // Usually pair noindex with nofollow
  openGraph: {
    basic: {
      title: seoTitle,
      type: 'article',
      image: new URL(ogImage, Astro.site).toString(),
      url: postUrl,
    },
    optional: {
      description: seoDescription,
      siteName: 'My MetaData',
    },
    image: {
      alt: ogImageAlt,
      width: 1200,
      height: 630,
    },
    article: {
      publishedTime: entry.data.publishDate.toISOString(),
      modifiedTime:
        entry.data.updatedDate?.toISOString() ||
        entry.data.publishDate.toISOString(),
      author: [entry.data.author],
      section: entry.data.category,
      tag: entry.data.tags,
    },
  },
  twitter: {
    creator: entry.data.author,
    site: '@nerajno',
    card: 'summary_large_image',
    title: seoTitle,
    description: seoDescription,
    image: new URL(ogImage, Astro.site).toString(),
    imageAlt: ogImageAlt,
  },
};
---

<Layout title={entry.data.title}>
  <ReadingProgressBar />
  <MarkContentAsSeen />
  <SEO
    title={seoConfig.title}
    description={seoConfig.description}
    canonical={seoConfig.canonical}
    noindex={seoConfig.noindex}
    nofollow={seoConfig.nofollow}
    openGraph={seoConfig.openGraph}
    twitter={seoConfig.twitter}
    extend={{
      meta: [
        { name: 'author', content: entry.data.author },
        { name: 'keywords', content: keywords?.join(', ') || '' },
        { property: 'article:author', content: entry.data.author },
        { property: 'article:section', content: entry.data.category },
        {
          property: 'article:published_time',
          content: entry.data.publishDate.toISOString(),
        },
        {
          property: 'article:modified_time',
          content:
            entry.data.updatedDate?.toISOString() ||
            entry.data.publishDate.toISOString(),
        },
        // Additional meta tags
        { property: 'og:locale', content: 'en_US' },
        { name: 'theme-color', content: '#1e293b' },
        { name: 'geo.region', content: 'US-GA' },
        { name: 'geo.placename', content: 'Atlanta' },
        { property: 'profile:first_name', content: 'Nerando' },
        { property: 'profile:last_name', content: 'Johnson' },
        // Reading time meta tag
        ...(remarkPluginFrontmatter?.minutesRead
          ? [
              { name: 'twitter:label1', content: 'Reading time' },
              {
                name: 'twitter:data1',
                content: remarkPluginFrontmatter.minutesRead,
              },
            ]
          : []),
      ],
      link: [
        // Prev/Next navigation for blog posts could be added here
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'My MetaData Blog RSS',
          href: '/rss.xml',
        },
      ],
    }}
  />

  <!-- JSON-LD Structured Data for Blog Post -->
  <script
    type='application/ld+json'
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: entry.data.title,
      description: seoDescription,
      image: {
        '@type': 'ImageObject',
        url: new URL(ogImage, Astro.site).toString(),
        alt: ogImageAlt,
        width: 1200,
        height: 630,
      },
      author: {
        '@type': 'Person',
        name: entry.data.author,
        url: `${Astro.site}about`,
        jobTitle: 'Software Developer',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Atlanta',
          addressRegion: 'GA',
          addressCountry: 'US',
        },
        sameAs: [
          'https://github.com/Nerajno',
          'https://twitter.com/nerajno',
          'https://www.linkedin.com/in/nerando-johnson/',
        ],
      },
      publisher: {
        '@type': 'Organization',
        name: 'My MetaData',
        url: Astro.site?.toString(),
        logo: {
          '@type': 'ImageObject',
          url: `${Astro.site}logo.png`, // Add your logo
          width: 400,
          height: 400,
        },
      },
      datePublished: entry.data.publishDate.toISOString(),
      dateModified:
        entry.data.updatedDate?.toISOString() ||
        entry.data.publishDate.toISOString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': postUrl,
      },
      url: postUrl,
      keywords: keywords?.join(', ') || (entry.data.tags ?? []).join(', '),
      articleSection: entry.data.category,
      wordCount: remarkPluginFrontmatter?.words || undefined,
      timeRequired: remarkPluginFrontmatter?.minutesRead || undefined,
      inLanguage: 'en-US',
      copyrightYear: entry.data.publishDate.getFullYear(),
      copyrightHolder: {
        '@type': 'Person',
        name: entry.data.author,
        sameAs: `${Astro.site}about`, // Add your about page URL for the author
      },
    })}
  />

  <Container>
    <div class='mx-auto max-w-4xl mt-14'>
      {
        entry.data.image && (
          <Image
            src={entry.data.image.src}
            alt={entry.data.image.alt}
            width={800}
            height={600}
            class='w-full object-cover rounded-lg mb-6'
          />
        )
      }

      <span class='text-blue-400 uppercase tracking-wider text-sm font-medium'>
        {entry.data.category}
      </span>
      <h1
        class='text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight'>
        {entry.data.title}
      </h1>
      <div class='flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap'>
        <span class='text-slate-500 dark:text-slate-400'>
          {entry.data.author}
        </span>
        <span class='text-slate-500 dark:text-slate-400'>•</span>
        <time
          class='text-slate-500 dark:text-slate-400'
          datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toDateString()}
        </time>
        {
          entry.data.updatedDate && (
            <>
              <span class='text-slate-500 dark:text-slate-400 hidden md:block'>
                •
              </span>
              <span class='text-slate-500 dark:text-slate-400 text-sm'>
                Updated: {entry.data.updatedDate.toDateString()}
              </span>
            </>
          )
        }
        <span class='text-slate-500 dark:text-slate-400 hidden md:block'>•</span
        >
        <div class='w-full md:w-auto flex flex-wrap gap-3'>
          {
            entry.data.tags.map((tag) => (
              <span class='text-sm text-slate-500 dark:text-slate-400'>
                #{tag}
              </span>
            ))
          }
        </div>
      </div>

      <div class='flex gap-2 items-center mt-2'>
        {
          remarkPluginFrontmatter?.minutesRead && (
          <p class='text-slate-500 dark:text-slate-400'>
            {remarkPluginFrontmatter.minutesRead}
          </p>
        )
      }
        <span class="text-slate-500 dark:text-slate-400">
          <ViewCounter slug={entry.slug} increment={true} />
        </span>
    </div>

    <!-- Series Navigation (if part of a series) -->
    {seriesNavProps && <SeriesNavigation {...seriesNavProps} />}

    <div
      class='mx-auto prose prose-lg mt-6 max-w-4xl dark:prose-invert prose-a:text-emerald-600 dark:prose-a:text-emerald-400 prose-headings:text-stone-800 dark:prose-headings:text-stone-100 prose-img:mx-auto'>
      {Content && <Content />}
      <!-- For embedding tweets -->
      {entry.data.tweetIds?.map((id) => <Tweet id={id} />)}
    </div>

    <!-- Series Navigation at bottom (if part of a series) -->
    {seriesNavProps && <SeriesNavigation {...seriesNavProps} />}

    <!-- Article navigation and sharing -->
    <div
      class='mx-auto max-w-4xl mt-12 pt-8 border-t border-slate-200 dark:border-slate-700'>
      <div class='flex flex-col sm:flex-row gap-4 justify-between items-center'>
        <a
          href='/blog'
          class='text-slate-500 dark:text-slate-300 hover:font-bold dark:bg-gray-600 px-5 py-3 rounded-md dark:hover:bg-gray-700 transition border border-slate-500 dark:border-slate-300'
          >← Back to Blogs</a
        >

        <!-- Social sharing buttons -->
        <div class="social-share-wrapper">
          <SocialShare
            description={seoDescription}
            title={entry.data.title}
            url={shortUrl}
            via="nerajno"
            buttons={[TwitterShareButton, LinkedInShareButton, BlueskyShareButton, WhatsAppShareButton]}
          />
        </div>
      </div>
    </div>
  </Container>
</Layout>

<style is:global>
  .social-share-wrapper svg {
    height: 32px;
    width: 32px;
    color: currentColor;
    fill: currentColor;
    transition: all 0.2s ease;
  }

  .social-share-wrapper svg:hover {
    color: #3b82f6;
    fill: #3b82f6;
    transform: scale(1.25);
  }

  .social-share-wrapper a {
    margin-right: 16px;
  }
</style>
