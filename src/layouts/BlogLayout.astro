---
import Container from "@components/container.astro";
import { getFormattedDate } from "@utils/all";
import Layout from "./Layout.astro";
import ReadingProgressBar from "@components/ReadingProgressBar.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <ReadingProgressBar />

  <Container>
    <div class="mx-auto max-w-[735px] mt-14">
      <span class="tag tag-primary uppercase tracking-wider text-sm font-medium">
        {frontmatter.category}
      </span>
      <h1
        class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight">
        {frontmatter.title}
      </h1>
      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
        <span style="color: var(--text-muted)">
          {frontmatter.author}
        </span>
        <span style="color: var(--text-muted)">•</span>
        <time style="color: var(--text-muted)" datetime={frontmatter.publishDate}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>
        <span style="color: var(--text-muted)" class="hidden md:block">•</span>
        <div class="w-full md:w-auto flex flex-wrap gap-3">
          {
            frontmatter.tags.map((tag) => (
              <span class="tag tag-primary">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mx-auto prose prose-lg mt-6 dark:prose-invert">
      <slot />
    </div>
    <div class="text-center mt-8">
      <a
        href="/blog"
        target="_blank" rel="noopener noreferrer"
        class="card inline-block px-5 py-3 rounded-md transition hover:shadow-md"
        style="color: var(--text-secondary)"
        >← Back to Blogs</a
      >
    </div>
  </Container>
</Layout>
