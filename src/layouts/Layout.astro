---
import { SEO } from 'astro-seo';
import Footer from '@components/footer.astro';
import Navbar from '@components/navbar/navbar.astro';
import '@fontsource-variable/inter/index.css';

export interface Props {
  title: string;
  description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  '/Banner_for_site.png',
  Astro.site
).toString();

const { title, description = "Nerando's Portfolio - Full-stack Developer" } =
  Astro.props;

// Use the provided title or fallback to default
const makeTitle = title || "Nerando's Portfolio";
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={description} />
    <!-- Prevent flash of unstyled content -->
    <script is:inline>
      (function () {
        function getInitialTheme() {
          if (typeof localStorage !== 'undefined') {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
              return savedTheme;
            }
          }
          if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches
          ) {
            return 'dark';
          }
          return 'light';
        }
        const theme = getInitialTheme();
        document.documentElement.classList.add(theme);
      })();
    </script>
    <!-- GA4 -->
    <script
      is:inline
      type="text/partytown"
      src='https://www.googletagmanager.com/gtag/js?id=G-Q3KQF674YW'></script>

    <script type="text/partytown">
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());

        // This is the important part
        gtag("consent", "default", {
          ad_storage: "granted`",
          ad_user_data: "granted",
          ad_personalization: "granted",
          analytics_storage: "granted",
        });

        gtag('config', 'G-Q3KQF674YW');
    </script>

    <meta name='viewport' content='width=device-width' />
    <link rel='icon' href='/my_favicon.ico' />
    <meta name='generator' content={Astro.generator} />
    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      twitter={{
        creator: 'nerajno',
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: 'website',
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Nerando's Portfolio ~ Meme Image",
        },
      }}
    />
  </head>
  <body
    class='bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 transition-colors duration-200'>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }

      /* Dark mode styles */
      :root {
        --color-text: #333333;
        --color-bg: #f5f5f5;
      }

      :root.dark {
        --color-text: #ffffff;
        --color-bg: #1a1a1a;
      }

      body {
        color: var(--color-text);
        background-color: var(--color-bg);
        transition:
          color 0.3s ease,
          background-color 0.3s ease;
      }

      body a {
        @apply text-blue-500 dark:text-blue-400;
      }
    </style>
    <!-- Load theme manager after body -->
    <script src='/src/scripts/theme.js' type='module'></script>
  </body>
</html>
