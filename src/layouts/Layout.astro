---
import { SEO } from 'astro-seo';
import Footer from '@components/footer.astro';
import Navbar from '@components/navbar/navbar.astro';
import '@fontsource-variable/inter/index.css';

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  '/Banner_for_site.png',
  Astro.site
).toString();

const { title } = Astro.props;

const makeTitle = "Nerando's Portfolio";
---

<!doctype html>
<html lang='en' class='light'>
  <!-- <html lang="en"> -->
  <head>
    <meta charset='UTF-8' />
    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src='https://www.googletagmanager.com/gtag/js?id=G-Q3KQF674YW'></script>
    <script "text/partytown">window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-Q3KQF674YW');
    </script>
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.classList.toggle('dark', savedTheme === 'dark');
      document.body.classList.toggle('dark', savedTheme === 'dark');
    </script>
    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description='This is a portfolio website of Nerando. It contains his projects, blogs, and other information.'
      canonical={canonicalURL}
      twitter={{
        creator: 'nerajno',
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: 'website',
          title: `Nerando's Portfolio`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Nerando's Portfolio ~ Meme Image",
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }

      /* Dark mode styles */
      :root {
        --color-text: #333333;
        --color-bg: #f5f5f5;
      }

      :root.dark {
        --color-text: #ffffff;
        --color-bg: #1a1a1a;
      }

      body {
        color: var(--color-text);
        background-color: var(--color-bg);
        transition:
          color 0.3s ease,
          background-color 0.3s ease;
      }
    </style>
  </body>
</html>
