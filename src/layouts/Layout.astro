---
import { SEO } from 'astro-seo';
import Footer from '@components/footer.astro';
import Navbar from '@components/navbar/navbar.astro';
import '@fontsource-variable/inter/index.css';

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  '/Banner_for_site.png',
  Astro.site
).toString();

const { title } = Astro.props;

// Use the provided title or fallback to default
const makeTitle = title || "Nerando's Portfolio";
---

<!doctype html>
<html lang='en' class='light'>
  <head>
    <meta charset='UTF-8' />
    <!-- GA4 -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-Q3KQF674YW"></script>
    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, any>[];
          gtag: (...args: any[]) => void;
        }
      }
      // This is the important part!
      document.addEventListener('astro:page-load', () => {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag(...args: any[]) {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });
        window.gtag('config', 'G-Q3KQF674YW');
      });
    </script>
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.classList.toggle('dark', savedTheme === 'dark');
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
    <SEO
      title={makeTitle}
      description='This is a portfolio website of Nerando. It contains his projects, blogs, and other information about his growth as a technical professional.'
      canonical={canonicalURL}
      twitter={{
        creator: 'nerajno',
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: 'website',
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Nerando's Portfolio ~ Meme Image",
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }

      /* Dark mode styles */
      :root {
        --color-text: #333333;
        --color-bg: #f5f5f5;
      }

      :root.dark {
        --color-text: #ffffff;
        --color-bg: #1a1a1a;
      }

      body {
        color: var(--color-text);
        background-color: var(--color-bg);
        transition:
          color 0.3s ease,
          background-color 0.3s ease;
      }
    </style>
  </body>
</html>
