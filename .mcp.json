{
  "mcpServers": {
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "netlify": {
      "command": "npx",
      "args": ["-y", "caveman-shrink", "npx", "-y", "@netlify/mcp"]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "caveman-shrink",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
