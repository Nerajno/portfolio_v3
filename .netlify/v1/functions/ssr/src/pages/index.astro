---
import Container from "@components/container.astro";
import Features from "@components/features.astro";
import Hero from "@components/hero.astro";
import Logos from "@components/logos.astro";
import Layout from "@layouts/Layout.astro";
import { AstroSEO } from 'astro-seo-plugin';

// SEO data for homepage
const pageTitle = "Nerando Johnson - Software Developer || Tech Community Organizer || Consultant -  DevelopingDvlpr Home Page" ;
const pageDescription = "Welcome to DevelopingDvlpr - A place for web based software development insights, digital gardens, and creative projects. Explore my journey as a developer and discover valuable resources.";
const pageUrl = "https://developingdvlpr.com";
const imageUrl = "https://developingdvlpr.com/images/og-image.png"; // You'll want to create this
---


<Layout title={pageTitle}>
  <!-- SEO Component for Homepage -->
  <AstroSEO
    title={pageTitle}
    description={pageDescription}
    canonical={pageUrl}
    openGraph={{
      title: pageTitle,
      description: pageDescription,
      image: imageUrl,
      type: "website",
      url: pageUrl,
      siteName: "DevelopingDvlpr"
    }}
    twitter={{
      card: "summary_large_image",
      site: "@nerajno",
      creator: "@nerajno",
      title: pageTitle,
      description: pageDescription,
      image: imageUrl
    }}
    jsonLd={{
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "DevelopingDvlpr",
      description: pageDescription,
      url: pageUrl,
      author: {
        "@type": "Person",
        name: "Nerando Johnson",
        url: pageUrl
      },
      potentialAction: {
        "@type": "SearchAction",
        target: `${pageUrl}/search?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    }}
    robots={{
      index: true,
      follow: true,
      noarchive: false,
      nosnippet: false,
      maxSnippet: 200,
    }}
    additionalLinkTags={[
      { rel: "canonical", href: pageUrl },
      { rel: "preconnect", href: "https://fonts.googleapis.com" },
      { rel: "dns-prefetch", href: "https://fonts.gstatic.com" }
    ]}
    additionalMetaTags={[
      {
        name: "keywords",
        content: "web development, developer, digital garden, programming, frontend, backend, javascript, react, astro, portfolio"
      },
      {
        name: "author",
        content: "Nerando Johnson"
      },
      {
        name: "viewport",
        content: "width=device-width, initial-scale=1.0"
      },
      {
        name: "theme-color",
        content: "#000000" // Replace with your brand color
      },
      {
        property: "og:locale",
        content: "en_US"
      }
    ]}
  />

  <Container>
    <Hero />
    <Features />
    <Logos />
  </Container>
</Layout>
