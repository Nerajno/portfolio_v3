---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import projectsData from '../../data/projects';

export async function getStaticPaths() {
  const allProjects = [
    ...projectsData.showcase_projects,
    ...projectsData.completed_projects,
  ];

  // Only create paths for projects that have case study data
  return allProjects
    .filter((project) => project.case_study)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;

// Add null checking for case_study
if (!project || !project.case_study) {
  return Astro.redirect('/404');
}

const caseStudy = project.case_study;
---

<Layout title={`${project.title} - Case Study`}>
  <Container>
    <main class='max-w-4xl mx-auto py-8'>
      <!-- Header -->
      <header class='mb-12'>
        <div class='flex items-center gap-4 mb-6'>
          <a
            href='/portfolio'
            class='text-blue-600 hover:text-blue-800 font-medium'>
            ← Back to Portfolio
          </a>
        </div>
        <h1 class='text-4xl font-bold text-gray-900 dark:text-white mb-4'>
          {project.title}
        </h1>
        <p class='text-xl text-gray-600 dark:text-gray-300 mb-6'>
          {project.subtitle}
        </p>
        <div class='flex gap-4'>
          {
            project.website && (
              <a
                href={project.website}
                target='_blank'
                rel='noopener noreferrer'
                class='bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors'>
                View Live Demo
              </a>
            )
          }
          <a
            href={project.github}
            target='_blank'
            rel='noopener noreferrer'
            class='border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors'>
            View Source Code
          </a>
        </div>
      </header>

      <!-- Project Images -->
      {
        caseStudy.images && caseStudy.images.length > 0 && (
          <section class='mb-12'>
            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
              {caseStudy.images.map((image, index) => (
                <img
                  src={image || '/placeholder.svg'}
                  alt={`${project.title} screenshot ${index + 1}`}
                  class='rounded-lg shadow-lg w-full h-auto'
                />
              ))}
            </div>
          </section>
        )
      }

      <!-- Project Overview -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Project Overview
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <p class='text-gray-700 dark:text-gray-300 mb-6 leading-relaxed'>
            {caseStudy.overview}
          </p>

          <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
            <div>
              <h3
                class='text-lg font-semibold text-gray-900 dark:text-white mb-3'>
                Problem Statement
              </h3>
              <p class='text-gray-700 dark:text-gray-300 leading-relaxed'>
                {caseStudy.problem}
              </p>
            </div>
            <div>
              <h3
                class='text-lg font-semibold text-gray-900 dark:text-white mb-3'>
                Target Audience
              </h3>
              <p class='text-gray-700 dark:text-gray-300 leading-relaxed'>
                {caseStudy.audience}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Features -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Key Features
        </h2>
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <ul class='grid grid-cols-1 md:grid-cols-2 gap-4'>
            {
              caseStudy.features.map((feature) => (
                <li class='flex items-start gap-3'>
                  <svg
                    class='w-5 h-5 text-green-500 mt-0.5 flex-shrink-0'
                    fill='currentColor'
                    viewBox='0 0 20 20'>
                    <path
                      fill-rule='evenodd'
                      d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
                      clip-rule='evenodd'
                    />
                  </svg>
                  <span class='text-gray-700 dark:text-gray-300'>
                    {feature}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Technical Stack -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Technical Stack
        </h2>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Frontend
            </h3>
            <div class='flex flex-wrap gap-2'>
              {
                caseStudy.tech_stack.frontend.map((tech) => (
                  <span class='bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-3 py-1 rounded-full text-sm font-medium'>
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Backend
            </h3>
            <div class='flex flex-wrap gap-2'>
              {
                caseStudy.tech_stack.backend.map((tech) => (
                  <span class='bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 px-3 py-1 rounded-full text-sm font-medium'>
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Database
            </h3>
            <div class='flex flex-wrap gap-2'>
              {
                caseStudy.tech_stack.database.map((tech) => (
                  <span class='bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 px-3 py-1 rounded-full text-sm font-medium'>
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Tools & DevOps
            </h3>
            <div class='flex flex-wrap gap-2'>
              {
                caseStudy.tech_stack.tools.map((tech) => (
                  <span class='bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 px-3 py-1 rounded-full text-sm font-medium'>
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Architecture & Trade-offs -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Architecture & Technical Decisions
        </h2>
        <div class='space-y-6'>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-3'>
              System Architecture
            </h3>
            <p class='text-gray-700 dark:text-gray-300 leading-relaxed'>
              {caseStudy.architecture}
            </p>
          </div>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Key Trade-offs
            </h3>
            <ul class='space-y-3'>
              {
                caseStudy.tradeoffs.map((tradeoff) => (
                  <li class='flex items-start gap-3'>
                    <svg
                      class='w-5 h-5 text-yellow-500 mt-0.5 flex-shrink-0'
                      fill='currentColor'
                      viewBox='0 0 20 20'>
                      <path
                        fill-rule='evenodd'
                        d='M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z'
                        clip-rule='evenodd'
                      />
                    </svg>
                    <span class='text-gray-700 dark:text-gray-300'>
                      {tradeoff}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Development Process -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Development Process
        </h2>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Timeline
            </h3>
            <p class='text-gray-700 dark:text-gray-300 mb-4'>
              {caseStudy.timeline}
            </p>

            <h4 class='font-semibold text-gray-900 dark:text-white mb-3'>
              Key Challenges
            </h4>
            <ul class='space-y-2'>
              {
                caseStudy.challenges.map((challenge) => (
                  <li class='flex items-start gap-2'>
                    <span class='text-red-500 mt-1'>•</span>
                    <span class='text-gray-700 dark:text-gray-300 text-sm'>
                      {challenge}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div
            class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
            <h3
              class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
              Key Learnings
            </h3>
            <ul class='space-y-3'>
              {
                caseStudy.learnings.map((learning) => (
                  <li class='flex items-start gap-3'>
                    <svg
                      class='w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0'
                      fill='currentColor'
                      viewBox='0 0 20 20'>
                      <path
                        fill-rule='evenodd'
                        d='M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z'
                        clip-rule='evenodd'
                      />
                    </svg>
                    <span class='text-gray-700 dark:text-gray-300 text-sm'>
                      {learning}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- Results & Impact -->
      <section class='mb-12'>
        <h2 class='text-3xl font-bold text-gray-900 dark:text-white mb-6'>
          Results & Impact
        </h2>

        <!-- Metrics -->
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700 mb-6'>
          <h3 class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
            Key Metrics
          </h3>
          <div class='grid grid-cols-2 md:grid-cols-3 gap-6'>
            {
              caseStudy.detailed_metrics.map((metric) => (
                <div class='text-center'>
                  <div class='text-2xl font-bold text-blue-600 dark:text-blue-400'>
                    {metric.value}
                  </div>
                  <div class='text-sm text-gray-600 dark:text-gray-400'>
                    {metric.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- User Feedback -->
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700 mb-6'>
          <h3 class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
            User Feedback
          </h3>
          <div class='space-y-4'>
            {
              caseStudy.feedback.map((feedback) => (
                <blockquote class='border-l-4 border-blue-500 pl-4 italic text-gray-700 dark:text-gray-300'>
                  <p class='mb-2'>{feedback.quote}</p>
                  <footer class='text-sm text-gray-500 dark:text-gray-400'>
                    — {feedback.author}
                  </footer>
                </blockquote>
              ))
            }
          </div>
        </div>

        <!-- Future Improvements -->
        <div
          class='bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700'>
          <h3 class='text-lg font-semibold text-gray-900 dark:text-white mb-4'>
            Future Improvements
          </h3>
          <ul class='space-y-2'>
            {
              caseStudy.improvements.map((improvement) => (
                <li class='flex items-start gap-3'>
                  <svg
                    class='w-5 h-5 text-purple-500 mt-0.5 flex-shrink-0'
                    fill='currentColor'
                    viewBox='0 0 20 20'>
                    <path
                      fill-rule='evenodd'
                      d='M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z'
                      clip-rule='evenodd'
                    />
                  </svg>
                  <span class='text-gray-700 dark:text-gray-300'>
                    {improvement}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Call to Action -->
      <section class='text-center py-8'>
        <h2 class='text-2xl font-bold text-gray-900 dark:text-white mb-4'>
          Interested in Learning More?
        </h2>
        <p class='text-gray-600 dark:text-gray-300 mb-6'>
          I'd love to discuss this project and my development process in more
          detail.
        </p>
        <div class='flex justify-center gap-4'>
          <a
            href='/contact'
            class='bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700 transition-colors'>
            Get In Touch
          </a>
          <a
            href='/portfolio'
            class='border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors'>
            View More Projects
          </a>
        </div>
      </section>
    </main>
  </Container>
</Layout>
